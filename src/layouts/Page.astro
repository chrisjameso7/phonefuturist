---
import '../styles/global.css';
import '../styles/observatory.css';
import {navigationFor} from '../lib/navigation';
interface Props { title: string; description?: string; privatePage?: boolean; home?: boolean }
const { title, description = 'Independent technology journalism, analysis and intelligence.', privatePage = false, home = false } = Astro.props;
const links = [['News','news'],['Reports','reports'],['Leaks','leaks'],['Analysis','analysis']];
const {signedIn,showStudio}=navigationFor(Astro.locals.user,Astro.locals.access);
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="robots" content={privatePage ? 'noindex, nofollow' : 'noindex'}/><title>{title} · PhoneFuturist</title></head>
<body><a class="skip" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/">PhoneFuturist<span aria-hidden="true">.</span></a><nav class="desktop-nav" aria-label="Main"><a href="/" aria-current={home?'page':undefined}>Home</a>{links.map(([name,key])=><a href={'/articles?section='+key}>{name}</a>)}<a href="/interactive-leaks">The Lab</a>{showStudio&&<a href="/studio">Studio</a>}</nav><div class="header-actions">{signedIn?<><a class="button" href="/account">My account <span aria-hidden="true">↗</span></a><form action="/auth/signout" method="post"><button class="secondary">Sign out</button></form></>:<><a class="sign-in" href="/login">Sign in</a><a class="button" href="/join">Get started</a></>}</div><details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile menu"><a href="/" aria-current={home?'page':undefined}>Home</a>{links.map(([name,key])=><a href={'/articles?section='+key}>{name}</a>)}<a href="/interactive-leaks">The Lab</a>{showStudio&&<a href="/studio">The Studio</a>}<div class="mobile-account">{signedIn?<><a href="/account">My account <span aria-hidden="true">↗</span></a><form action="/auth/signout" method="post"><button class="secondary">Sign out</button></form></>:<><a class="sign-in" href="/login">Sign in</a><a class="button" href="/join">Get started</a></>}</div></nav></details></header><main id="main" class:list={{ 'home-page': home }}><slot/></main><footer><a class="brand" href="/">PhoneFuturist<span>.</span></a><span>Independent thinking. Informed perspective.<br/>Technology, examined.</span><a href="/#about">About the publication ↗</a></footer></body></html>
