---
import '../styles/global.css';
import '../styles/observatory.css';
import '../styles/navigation-glass.css';
import '../styles/optical-pointer.css';
import '../styles/brand-theme.css';
import { navigationFor, activeNavigation } from '../lib/navigation';

interface Props {
  title: string;
  description?: string;
  privatePage?: boolean;
  home?: boolean;
  productMode?: boolean;
}

const {
  title,
  description = 'Independent technology journalism, analysis and intelligence.',
  privatePage = false,
  home = false,
  productMode = false,
} = Astro.props;

const links = [
  ['Newsroom', 'newsroom'],
  ['News', 'news'],
  ['Leaks', 'leaks'],
  ['Analysis', 'analysis'],
];

const { signedIn, showStudio } = navigationFor(
  Astro.locals.user,
  Astro.locals.access,
);

const active = activeNavigation(Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <script is:inline src="/theme-init.js"></script>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta name="description" content={description} />

    <meta
      name="robots"
      content={privatePage ? 'noindex, nofollow' : 'noindex'}
    />

    <title>{title} · PhoneFuturist</title>
  </head>

  <body class:list={{ 'product-mode': productMode }}>
    <a class="skip" href="#main">Skip to content</a>

    {
      !productMode && (
        <>
          <div class="header-scroll-sentinel" aria-hidden="true"></div>

          <div class="mobile-appbar" aria-label="PhoneFuturist mobile header">
            <a class="mobile-app-brand" href="/" aria-label="PhoneFuturist home">
              <img src="/assets/phonefuturist-mark.svg" alt="" width="46" height="22" />
              <span>Phone<span>Futurist</span></span>
            </a>
            <a class="mobile-app-action" href={signedIn ? '/account' : '/login'} aria-label={signedIn ? 'Open account' : 'Sign in'}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>
              <span aria-hidden="true"></span>
            </a>
          </div>

          <header class="site-header">
            <div class="header-brand-row">
              <a class="brand brand-lockup" href="/" aria-label="PhoneFuturist home">
                <img class="brand-mark" src="/assets/phonefuturist-mark.svg" alt="" width="58" height="26" />
                <span class="brand-word">PhoneFuturist</span>
              </a>

              <details class="mobile-nav">
                <summary
                  aria-label="Navigation menu"
                  aria-controls="mobile-navigation-panel"
                >
                  <span class="mobile-menu-label">Menu</span>

                  <span class="mobile-menu-icon" aria-hidden="true">
                    <span></span>
                    <span></span>
                  </span>
                </summary>

                <div class="mobile-menu-panel" id="mobile-navigation-panel">
                  <nav class="mobile-menu-primary" aria-label="Mobile">
                    <a
                      href="/"
                      aria-current={active === 'home' ? 'page' : undefined}
                    >
                      <span>Home</span>
                      <span aria-hidden="true">↗</span>
                    </a>

                    {
                      links.map(([name, key]) => (
                        <a
                          href={key === 'newsroom' ? '/articles' : '/articles?section=' + key}
                          aria-current={active === key ? 'page' : undefined}
                        >
                          <span>{name}</span>
                          <span aria-hidden="true">↗</span>
                        </a>
                      ))
                    }
                    <a
                      href="/interactive-leaks"
                      aria-current={active === 'lab' ? 'page' : undefined}
                    >
                      <span>Interactive Leaks</span>
                      <span aria-hidden="true">↗</span>
                    </a>

                    {
                      showStudio && (
                        <a
                          href="/studio"
                          aria-current={active === 'studio' ? 'page' : undefined}
                        >
                          <span>The Studio</span>
                          <span aria-hidden="true">↗</span>
                        </a>
                      )
                    }
                  </nav>

                  <div class="mobile-account">

                    <span class="mobile-account-label">Account</span>

                    {
                      signedIn ? (
                        <div class="mobile-account-actions">
                          <a
                            class="mobile-account-primary"
                            href="/account"
                          >
                            My account
                          </a>

                          <form action="/auth/signout" method="post">
                            <button
                              type="submit"
                              class="mobile-account-secondary"
                            >
                              Sign out
                            </button>
                          </form>
                        </div>
                      ) : (
                        <div class="mobile-account-actions">
                          <a
                            class="mobile-account-secondary"
                            href="/login"
                          >
                            Sign in
                          </a>

                          <a
                            class="mobile-account-primary"
                            href="/join"
                          >
                            Get started
                          </a>
                        </div>
                      )
                    }
                  </div>
                </div>
              </details>
            </div>

            <nav class="desktop-nav" aria-label="Main">
              <a
                href="/"
                aria-current={active === 'home' ? 'page' : undefined}
              >
                Home
              </a>

              <a
                href="/articles"
                aria-current={['newsroom','news','leaks','analysis'].includes(active ?? '') ? 'page' : undefined}
              >
                Newsroom
              </a>
              <a
                href="/interactive-leaks"
                aria-current={active === 'lab' ? 'page' : undefined}
              >
                Interactive Leaks
              </a>

              {
                showStudio && (
                  <a
                    href="/studio"
                    aria-current={active === 'studio' ? 'page' : undefined}
                  >
                    Studio
                  </a>
                )
              }
            </nav>

            <div class="header-actions">
              {
                signedIn ? (
                  <>
                    <a class="button" href="/account">
                      My account <span aria-hidden="true">↗</span>
                    </a>

                    <form action="/auth/signout" method="post">
                      <button class="secondary" type="submit">
                        Sign out
                      </button>
                    </form>
                  </>
                ) : (
                  <>
                    <a class="sign-in" href="/login">
                      Sign in
                    </a>

                    <a class="button" href="/join">
                      Get started
                    </a>
                  </>
                )
              }
            </div>
          </header>
        </>
      )
    }

    {
      !productMode && (
        <nav class="mobile-tabbar" aria-label="Mobile app navigation">
          <a href="/" aria-current={active === 'home' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3l8.5 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-5v-6h-4v6H5a1.5 1.5 0 0 1-1.5-1.5z"/></svg>
            <span>Home</span>
          </a>
          <a href="/articles" aria-current={['newsroom','news','leaks','analysis'].includes(active ?? '') ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h14v15H5zM8 8h8M8 11.5h8M8 15h5"/></svg>
            <span>Newsroom</span>
          </a>
          <a class="mobile-tabbar-lab" href="/interactive-leaks" aria-current={active === 'lab' ? 'page' : undefined}>
            <span class="mobile-lab-orb" aria-hidden="true">
              <img src="/assets/phonefuturist-mark.svg" alt="" width="30" height="14" />
            </span>
            <span>Leaks</span>
          </a>
          {showStudio && (
            <a href="/studio" aria-current={active === 'studio' ? 'page' : undefined}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16v12H4zM8 4v5M16 4v5M8 13h8M8 16h5"/></svg>
              <span>Studio</span>
            </a>
          )}
          <a href={signedIn ? '/account' : '/login'} aria-current={active === 'account' ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/></svg>
            <span>{signedIn ? 'Account' : 'Sign in'}</span>
          </a>
        </nav>
      )
    }

    <main
      id="main"
      class:list={{
        'home-page': home,
        'product-main': productMode,
      }}
    >
      <slot />
    </main>

    {
      !productMode && (
        <footer>

          <a class="brand brand-lockup" href="/" aria-label="PhoneFuturist home">
            <img class="brand-mark" src="/assets/phonefuturist-mark.svg" alt="" width="58" height="26" />
            <span class="brand-word">PhoneFuturist</span>
          </a>

          <span>
            Independent thinking. Informed perspective.<br />
            Technology, examined.
          </span>

          <a href="/#about">
            About the publication ↗
          </a>
        </footer>
      )
    }
  </body>
</html>

<script>
  import { enhanceNavigation } from '../lib/navigation-client';
  import { enhanceOpticalPointer } from '../lib/optical-pointer-client';

  enhanceNavigation();
  enhanceOpticalPointer();
</script>