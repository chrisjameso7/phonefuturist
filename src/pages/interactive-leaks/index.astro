---
import Page from '../../layouts/Page.astro';
import '../../styles/lab-simulator.css';
---

<Page
  title="Interactive Leaks"
  description="Build and test unreleased device concepts with PhoneFuturist's deterministic hardware simulation engine. Public Beta."
>
  <main class="lab-page">
    <!-- ============ HERO ============ -->
    <section class="lab-hero">
      <div class="lab-hero-main">
        <p class="lab-eyebrow">PhoneFuturist Lab · Public Beta</p>

        <h1>
          Interactive
          <span>Leaks.</span>
        </h1>

        <p class="lab-intro">
          Don't just read the specifications. Test them.
        </p>

        <p class="lab-description">
          Build an unreleased device from reported or estimated
          specifications, describe how it would actually be used, and see
          what the numbers imply. Deterministic where it can be. Honest
          where it can't.
        </p>

        <div class="lab-hero-actions">
          <a class="lab-cta" href="/interactive-leaks/simulate">
            Open the simulator →
          </a>

          <a class="lab-ghost" href="#methodology">How it works</a>
        </div>

        <div class="lab-principles">
          <span>Evidence in</span>
          <span>Math applied</span>
          <span>No invented specifications</span>
        </div>
      </div>

      <div class="lab-device-wrap" aria-hidden="true">
        <div class="lab-halo"></div>
        <div class="lab-orbit lab-orbit-one"></div>
        <div class="lab-orbit lab-orbit-two"></div>

        <div class="lab-phone">
          <div class="lab-screen">
            <span class="lab-screen-line"></span>
            <span class="lab-screen-line lab-screen-line-short"></span>
          </div>

          <div class="lab-camera lab-camera-one"></div>
          <div class="lab-camera lab-camera-two"></div>
          <div class="lab-camera lab-camera-three"></div>
          <div class="lab-flash"></div>

          <div class="lab-mark">
            <strong>PF</strong>
            <span>SIM · BETA</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CAPABILITIES ============ -->
    <section class="lab-capabilities">
      <div class="lab-capabilities-heading">
        <p class="lab-eyebrow">What the Beta does</p>
        <h2>
          Three layers.
          <span>One result.</span>
        </h2>
      </div>

      <div class="lab-cap-grid">
        <article class="lab-cap">
          <span class="lab-cap-index">01</span>
          <h3>Device</h3>
          <p>
            The physical envelope. Dimensions, display geometry, battery
            cells, camera modules — evaluated deterministically, from
            geometry you supply.
          </p>
          <ul>
            <li>Pack energy &amp; volume</li>
            <li>Pixel density</li>
            <li>Screen-to-body ratio</li>
            <li>Internal volume budget</li>
          </ul>
        </article>

        <article class="lab-cap">
          <span class="lab-cap-index">02</span>
          <h3>Environment</h3>
          <p>
            How the device is used. Assign average power per workload —
            web, video, gaming — and the engine derives runtime from the
            mixture, with intervals intact.
          </p>
          <ul>
            <li>Six named workloads</li>
            <li>Weighted profiles</li>
            <li>Usable-energy derating</li>
            <li>Worst-case / best-case bounds</li>
          </ul>
        </article>

        <article class="lab-cap">
          <span class="lab-cap-index">03</span>
          <h3>Model</h3>
          <p>
            The versioned engine itself. Every result carries its model
            versions, its assumptions and its confidence — so the same
            inputs always produce the same result.
          </p>
          <ul>
            <li>Versioned &amp; reproducible</li>
            <li>Provenance-aware confidence</li>
            <li>Explicit assumptions</li>
            <li>Unresolved, never guessed</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- ============ ENGINE STATUS ============ -->
    <section class="lab-status">
      <div class="lab-status-card">
        <span class="lab-status-dot" aria-hidden="true"></span>
        <div>
          <strong>Live during Beta</strong>
          <p>
            Deterministic device core · battery runtime model · provenance
            and confidence reporting
          </p>
        </div>
      </div>

      <div class="lab-status-card lab-status-muted">
        <span class="lab-status-dot lab-status-dot-muted" aria-hidden="true"></span>
        <div>
          <strong>Coming during Beta</strong>
          <p>
            Performance, thermal and camera-image simulation are under
            active development. Inputs accepted; results not claimed.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ ENTRY ============ -->
    <section class="lab-entry">
      <div class="lab-entry-card">
        <div>
          <p class="lab-eyebrow">The instrument</p>
          <h2>
            Configure a device.
            <span>Run the model.</span>
          </h2>
          <p class="lab-entry-copy">
            The simulation workspace pairs a simple core path — name,
            envelope, battery, usage power — with the full engineering
            detail one disclosure away. Results read like an instrument,
            not a spreadsheet.
          </p>
        </div>

        <a class="lab-cta" href="/interactive-leaks/simulate">
          Start a simulation →
        </a>
      </div>
    </section>

    <!-- ============ METHODOLOGY ============ -->
    <section class="lab-methodology" id="methodology">
      <div class="lab-methodology-heading">
        <p class="lab-eyebrow">Methodology</p>
        <h2>Calculation, not clairvoyance.</h2>
      </div>

      <div class="lab-method-grid">
        <article>
          <span>01</span>
          <h3>Known stays known.</h3>
          <p>
            Measurements and specifications you provide are preserved as
            inputs rather than quietly replaced with assumptions.
          </p>
        </article>

        <article>
          <span>02</span>
          <h3>Unknown stays unknown.</h3>
          <p>
            Missing information remains missing when the engine cannot
            calculate it honestly from the available data.
          </p>
        </article>

        <article>
          <span>03</span>
          <h3>Math stays reproducible.</h3>
          <p>
            Engine and model versions are attached to every result, so the
            same inputs evaluated against the same model give the same
            answer.
          </p>
        </article>
      </div>
    </section>
  </main>
</Page>

<style>
  /* Landing-specific sections. Shared page/instrument styles come
     from src/styles/lab-simulator.css. */

  /* ---------------- HERO ---------------- */

  .lab-hero {
    min-height: 600px;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    align-items: center;
    gap: 64px;
    padding: 24px 0 80px;
  }

  .lab-hero h1 {
    margin: 0;
    max-width: 700px;
    color: var(--ink);
    font-size: clamp(3.6rem, 8vw, 7.6rem);
    line-height: 0.86;
    letter-spacing: -0.07em;
    font-weight: 650;
  }

  .lab-hero h1 span {
    display: block;
    color: #d3d0bd;
  }

  .lab-intro {
    margin: 34px 0 0;
    color: var(--ink);
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
  }

  .lab-description {
    max-width: 580px;
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.75;
  }

  .lab-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .lab-principles {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 28px;
  }

  .lab-principles span {
    padding: 9px 13px;
    border: 1px solid #ffffff26;
    border-radius: 999px;
    background: #ffffff08;
    color: var(--muted);
    font-size: 0.74rem;
  }

  /* ---------------- HERO DEVICE (pure CSS) ---------------- */

  .lab-device-wrap {
    min-height: 520px;
    display: grid;
    place-items: center;
    position: relative;
  }

  .lab-halo {
    position: absolute;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(circle, #c9c9a42e, transparent 70%);
    pointer-events: none;
  }

  .lab-orbit {
    position: absolute;
    border: 1px solid #e2dfc146;
    border-radius: 50%;
  }

  .lab-orbit-one {
    width: 420px;
    height: 420px;
  }

  .lab-orbit-two {
    width: 520px;
    height: 240px;
    transform: rotate(-24deg);
  }

  .lab-phone {
    width: 220px;
    height: 436px;
    position: relative;
    z-index: 2;
    border: 1px solid #ffffff2e;
    border-radius: 40px;
    background: linear-gradient(150deg, #3d3e3b, #232422 62%, #1c1d1b);
    box-shadow:
      0 45px 90px #201d1973,
      inset 0 1px #ffffff14;
    transform: rotate(7deg);
  }

  .lab-phone::before {
    content: "";
    position: absolute;
    inset: 9px;
    border: 1px solid #ffffff0d;
    border-radius: 32px;
  }

  .lab-screen {
    position: absolute;
    inset: 12px;
    border-radius: 30px;
    background: linear-gradient(165deg, #171a1d, #101316 70%);
    overflow: hidden;
  }

  .lab-screen-line {
    position: absolute;
    left: 20px;
    right: 56px;
    top: 46px;
    height: 10px;
    border-radius: 5px;
    background: #e4e3cb26;
  }

  .lab-screen-line-short {
    top: 68px;
    right: 96px;
    height: 7px;
    background: #e4e3cb1a;
  }

  .lab-camera {
    position: absolute;
    z-index: 3;
    width: 52px;
    height: 52px;
    border: 7px solid #2a2d31;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #59667533 0 4%, #121820 18%, #06080a 57%);
    box-shadow: 0 0 0 1px #ffffff14, 0 8px 18px #00000040;
  }

  .lab-camera-one { top: 30px; left: 27px; }
  .lab-camera-two { top: 30px; left: 96px; }
  .lab-camera-three { top: 98px; left: 27px; }

  .lab-flash {
    position: absolute;
    z-index: 3;
    top: 114px;
    left: 116px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #ddd7b8;
  }

  .lab-mark {
    position: absolute;
    left: 27px;
    right: 27px;
    bottom: 28px;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    color: var(--muted);
  }

  .lab-mark strong {
    color: #f2efdf;
    font-size: 1.25rem;
    letter-spacing: -0.05em;
  }

  .lab-mark span {
    font-size: 0.6rem;
    letter-spacing: 0.16em;
  }

  /* ---------------- CAPABILITIES ---------------- */

  .lab-capabilities {
    padding: 88px 0;
    border-top: 1px solid #ffffff1f;
  }

  .lab-capabilities-heading h2,
  .lab-entry-card h2,
  .lab-methodology h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 3.8vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.05em;
    font-weight: 600;
  }

  .lab-capabilities-heading h2 span,
  .lab-entry-card h2 span {
    display: block;
    color: #d3d0bd;
  }

  .lab-cap-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 48px;
  }

  .lab-cap {
    display: flex;
    flex-direction: column;
    min-height: 320px;
    padding: 26px;
    border: 1px solid #ffffff26;
    border-radius: 24px;
    background: linear-gradient(150deg, #3a3b38, #2b2c29);
  }

  .lab-cap-index {
    color: #e0dfc8;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }

  .lab-cap h3 {
    margin: 40px 0 10px;
    color: var(--ink);
    font-size: 1.55rem;
    letter-spacing: -0.04em;
  }

  .lab-cap > p {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  .lab-cap ul {
    margin: 18px 0 0;
    padding: 16px 0 0;
    border-top: 1px solid #ffffff1a;
    list-style: none;
    display: grid;
    gap: 7px;
  }

  .lab-cap li {
    color: #d6d4c6;
    font-size: 0.74rem;
    letter-spacing: 0.02em;
  }

  .lab-cap li::before {
    content: "—";
    margin-right: 8px;
    color: #b9b7a2;
  }

  /* ---------------- ENGINE STATUS ---------------- */

  .lab-status {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 0 0 88px;
  }

  .lab-status-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 22px 24px;
    border: 1px solid #d6d8ba40;
    border-radius: 20px;
    background: #65655f;
  }

  .lab-status-muted {
    background: #3b3c39;
    border-color: #ffffff24;
  }

  .lab-status-card strong {
    color: var(--ink);
    font-size: 0.92rem;
    letter-spacing: -0.01em;
  }

  .lab-status-card p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .lab-status-dot {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    margin-top: 6px;
    border-radius: 50%;
    background: #d9dbb5;
    box-shadow: 0 0 12px #d9dbb580;
  }

  .lab-status-dot-muted {
    background: #8e9188;
    box-shadow: none;
  }

  /* ---------------- ENTRY ---------------- */

  .lab-entry {
    padding: 0 0 88px;
  }

  .lab-entry-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: 44px 40px;
    border: 1px solid #d6d8ba4d;
    border-radius: 28px;
    background:
      radial-gradient(circle at 88% 12%, #c9c9a42b, transparent 55%),
      #4a4b45;
  }

  .lab-entry-copy {
    max-width: 520px;
    margin: 18px 0 0;
    color: #e0ddd4;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .lab-entry-card .lab-cta {
    flex: 0 0 auto;
  }

  /* ---------------- METHODOLOGY ---------------- */

  .lab-methodology {
    padding: 88px 0 30px;
    border-top: 1px solid #ffffff1f;
  }

  .lab-methodology-heading {
    max-width: 660px;
  }

  .lab-method-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 50px;
    background: #ffffff1f;
    border: 1px solid #ffffff1f;
    border-radius: 24px;
    overflow: hidden;
  }

  .lab-method-grid article {
    min-height: 235px;
    padding: 26px;
    background: #333431;
  }

  .lab-method-grid article > span {
    color: #e0dfc8;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
  }

  .lab-method-grid h3 {
    margin: 58px 0 12px;
    color: var(--ink);
    font-size: 1.08rem;
    letter-spacing: -0.025em;
  }

  .lab-method-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  /* ---------------- RESPONSIVE ---------------- */

  @media (max-width: 1080px) {
    .lab-hero {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 28px;
    }

    .lab-device-wrap {
      transform: scale(0.82);
    }

    .lab-cap-grid {
      grid-template-columns: 1fr;
    }

    .lab-cap {
      min-height: 0;
    }

    .lab-cap h3 {
      margin-top: 24px;
    }
  }

  @media (max-width: 820px) {
    .lab-hero {
      min-height: auto;
      grid-template-columns: 1fr;
      padding-bottom: 60px;
    }

    .lab-device-wrap {
      min-height: 360px;
      margin: -20px 0;
      transform: scale(0.78);
    }

    .lab-capabilities {
      padding: 64px 0;
    }

    .lab-status {
      grid-template-columns: 1fr;
      padding-bottom: 64px;
    }

    .lab-entry {
      padding-bottom: 64px;
    }

    .lab-methodology {
      padding: 64px 0 30px;
    }

    .lab-method-grid {
      grid-template-columns: 1fr;
    }

    .lab-method-grid article {
      min-height: 0;
    }

    .lab-method-grid h3 {
      margin-top: 32px;
    }

    .lab-entry-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 30px 24px;
    }
  }

  @media (max-width: 600px) {
    .lab-hero h1 {
      font-size: clamp(3.2rem, 17vw, 5.2rem);
    }

    .lab-hero-actions .lab-cta,
    .lab-hero-actions .lab-ghost {
      flex: 1 1 auto;
      justify-content: center;
    }

    .lab-principles {
      gap: 6px;
    }
  }
</style>
