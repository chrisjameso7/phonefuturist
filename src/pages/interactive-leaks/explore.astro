---
import Page from '../../layouts/Page.astro';
import CommunityFeed from '../../components/community/CommunityFeed';
import CommunityPeople from '../../components/community/CommunityPeople';
import {searchCreators} from '../../lib/creator-identity';
import {serverClient,settings} from '../../lib/supabase';
import '../../components/community/community.css';
const query=(Astro.url.searchParams.get('q')??'').slice(0,80);
let results:any[]=[];let error='';
if(query){const client=Astro.locals.supabase??(settings()?serverClient(Astro.cookies,Astro.request):null);if(client){const response=await searchCreators(client,query);results=response.rows;error=response.error;}else error='Creator search is temporarily unavailable.';}
---
<Page title="Community" description="Share device builds, discuss hardware choices and follow PhoneFuturist creators.">
<section class="community-search" aria-label="Creator search"><form method="get" action="/interactive-leaks/explore"><label>Find creators<input type="search" name="q" maxlength="20" value={query} placeholder="Search by handle"/></label><button type="submit">Search</button></form>{error&&<p role="status">{error}</p>}{query&&!error&&(results.length?<CommunityPeople personIds={results.map(r=>r.user_id)} title="Creator results" client:load/>:<p role="status">No creators match this handle.</p>)}</section>
<CommunityFeed client:load/>
</Page>
