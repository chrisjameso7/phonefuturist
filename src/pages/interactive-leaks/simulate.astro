---
import Page from '../../layouts/Page.astro';
import InteractiveLeaksSimulator from '../../components/interactive-leaks/InteractiveLeaksSimulator';
import '../../styles/lab-simulator.css';
---

<Page
  title="Galaxy S27 Ultra — Interactive Leaks"
  description="Build, test, compare and inspect evidence-aware simulations for unreleased devices."
  privatePage={true}
  productMode={true}
>
  <div class="il-product">
    <section class="il-device-head">
      <div>
        <a class="il-back" href="/interactive-leaks">← Back to device</a>
        <div class="il-title-row">
          <h1>Galaxy S27 Ultra</h1>
          <span class="il-pill il-pill-unreleased">Unreleased</span>
          <span class="il-pill">87% confidence</span>
        </div>
        <p>Interactive Leak Lab · 46 tracked rumors · expected Feb 2027</p>
      </div>

      <div class="il-head-actions">
        <button class="il-secondary" type="button">Compare</button>
        <a class="il-primary" href="#interactive-simulator">Run simulation</a>
      </div>
    </section>

    <div class="il-disclaimer">
      <strong>Simulated result</strong>
      <span>Based on publicly reported specifications, estimated specifications, historical device behavior, and PhoneFuturist modeling. Actual performance may differ.</span>
    </div>

    <nav class="il-stage-tabs" aria-label="Simulation stages">
      <a class="is-active" href="#interactive-simulator">Build</a>
      <a href="#interactive-simulator">Test</a>
      <a href="#interactive-simulator">Compare</a>
      <a href="#interactive-simulator">Results</a>
    </nav>

    <main id="interactive-simulator" class="il-workspace">
      <InteractiveLeaksSimulator client:load />
    </main>
  </div>
</Page>
