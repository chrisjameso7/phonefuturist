---
import Page from '../../layouts/Page.astro';
import LabPortal from '../../components/LabPortal.astro';
import InteractiveLeaksSimulator from '../../components/interactive-leaks/InteractiveLeaksSimulator';
import '../../styles/lab-simulator.css';
---

<Page
  title="Interactive Leaks — Simulation Laboratory"
  description="Configure a device, define its environment, and examine model-derived device behaviour inside the Interactive Leaks simulation laboratory."
  privatePage={true}
  productMode={true}
>
  <LabPortal />

  <div class="lab-product">
    <header class="lab-product-header">
      <div class="lab-product-brand">
        <a
          class="lab-product-mark"
          href="/interactive-leaks"
          aria-label="Back to Interactive Leaks"
        >
          <span class="lab-product-mark-pf">PF</span>
          <span class="lab-product-mark-divider" aria-hidden="true">/</span>
          <span class="lab-product-mark-lab">LAB</span>
        </a>

        <div class="lab-product-identity">
          <span>Interactive Leaks</span>
          <strong>Simulation Laboratory</strong>
        </div>
      </div>

      <div class="lab-product-meta">
        <span class="lab-product-beta">
          <span class="lab-product-live-dot" aria-hidden="true"></span>
          Public Beta
        </span>

        <a class="lab-product-exit" href="/interactive-leaks">
          Exit Lab
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>

    <section
      class="lab-product-intro"
      aria-labelledby="lab-workspace-title"
    >
      <div class="lab-product-intro-copy">
        <p class="lab-product-kicker">
          Device simulation environment
        </p>

        <h1 id="lab-workspace-title">
          Model the device.<br />
          <span>Interrogate the outcome.</span>
        </h1>

        <p class="lab-product-description">
          Build a hypothetical device, define its operating conditions, and
          inspect what the current PhoneFuturist models can actually support.
          Unsupported conclusions remain unresolved rather than being invented.
        </p>
      </div>

      <div class="lab-product-system">
        <div class="lab-product-system-head">
          <span>System</span>
          <span class="lab-product-system-state">
            Operational
          </span>
        </div>

        <dl>
          <div>
            <dt>Workspace</dt>
            <dd>Interactive Leaks</dd>
          </div>

          <div>
            <dt>Engine</dt>
            <dd>Deterministic</dd>
          </div>

          <div>
            <dt>Build</dt>
            <dd>Public Beta</dd>
          </div>
        </dl>
      </div>
    </section>

    <div class="lab-product-rule" aria-hidden="true">
      <span>DEVICE</span>
      <span>ENVIRONMENT</span>
      <span>MODEL</span>
      <span>RESULT</span>
    </div>

    <main
      class="lab-product-workspace"
      aria-label="Interactive Leaks simulator"
    >
      <div class="lab-simulator-shell">
        <InteractiveLeaksSimulator client:load />
      </div>
    </main>

    <footer class="lab-product-footer">
      <div>
        <span class="lab-product-footer-mark">
          PF / LAB
        </span>

        <p>
          Interactive Leaks is an experimental PhoneFuturist research product.
        </p>
      </div>

      <p>
        Results are constrained by the model version, supplied assumptions,
        and available evidence.
      </p>
    </footer>
  </div>
</Page>