---
import Page from '../../layouts/Page.astro';
import InteractiveLeaksSimulator from '../../components/interactive-leaks/InteractiveLeaksSimulator';
import '../../styles/lab-simulator.css';
---

<Page
  title="Virtual Device · PhoneFuturist Lab"
  description="Pick a device, build its current virtual model and test how changing hardware assumptions changes the outcome."
  privatePage={true}
  productMode={true}
>
  <div class="il-product">
    <header class="il-product-nav">
      <a class="il-product-brand" href="/">
        <img src="/assets/phonefuturist-mark.svg" alt="" width="52" height="24" />
        <span>PhoneFuturist</span>
      </a>
      <nav aria-label="Lab navigation">
        <a href="/interactive-leaks">Lab</a>
        <a href="/interactive-leaks/explore">Explore</a>
      </nav>
      <a class="il-product-account" href="/account">Account</a>
    </header>

    <section class="il-device-head">
      <div>
        <a class="il-back" href="/interactive-leaks">← PhoneFuturist Lab</a>
        <div class="il-title-row">
          <h1>Virtual Device</h1>
          <span class="il-pill il-pill-unreleased">Lab</span>
        </div>
        <p>Pick the device yourself. PhoneFuturist builds the current model from the evidence attached to that device.</p>
      </div>

      <div class="il-head-actions">
        <a class="il-primary" href="#interactive-simulator">Pick a device</a>
      </div>
    </section>

    <div class="il-disclaimer">
      <strong>Modeled result</strong>
      <span>A virtual device is not a claim about final retail hardware. Pick a device, build its model, then change supported assumptions and watch the consequences update.</span>
    </div>

    <main id="interactive-simulator" class="il-workspace">
      <InteractiveLeaksSimulator client:load />
    </main>

    <nav class="il-product-tabbar" aria-label="Virtual Device navigation">
      <a href="/" aria-label="Home">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 10.5 12 3l8.5 7.5v9a1.5 1.5 0 0 1-1.5 1.5h-5v-6h-4v6H5a1.5 1.5 0 0 1-1.5-1.5z"/></svg>
      </a>
      <a href="/articles" aria-label="Newsroom">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h14v15H5zM8 8h8M8 11.5h8M8 15h5"/></svg>
      </a>
      <a class="is-active il-product-tabbar-lab" href="/interactive-leaks" aria-label="Lab">
        <span><img src="/assets/phonefuturist-mark.svg" alt="" width="34" height="17" /></span>
      </a>
      <a href="/account" aria-label="Account">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"/></svg>
      </a>
    </nav>
  </div>
</Page>

<style>
  .il-product-nav{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:58px;margin-bottom:18px;padding:8px 4px;border-bottom:1px solid color-mix(in srgb,var(--ink) 9%,transparent)}
  .il-product-brand{display:flex;align-items:center;gap:9px;color:var(--ink);text-decoration:none;font-size:.8rem;font-weight:760}
  .il-product-brand img{width:38px;height:22px}
  .il-product-nav nav{display:flex;gap:4px}
  .il-product-nav nav a,.il-product-account{padding:8px 10px;border-radius:8px;color:var(--muted);text-decoration:none;font-size:.68rem}
  .il-product-nav nav a:first-child{color:var(--ink);background:color-mix(in srgb,var(--accent) 10%,transparent)}
  .il-product-nav a:hover{color:var(--ink)}
  @media(max-width:620px){.il-product-nav nav{display:none}.il-device-head{padding-top:10px}}
</style>

<style>
  .il-product-tabbar{display:none}
  @media(max-width:620px){
    .product-main{padding:0!important}
    .il-product{
      width:100%!important;
      padding:0 12px 92px!important;
      background:radial-gradient(480px 240px at 50% -70px,rgb(22 140 255/.10),transparent 70%),#05080d;
    }
    .il-product-nav{
      position:sticky;
      top:0;
      z-index:80;
      min-height:60px;
      margin:0 -12px 10px;
      padding:8px 16px;
      border-bottom:1px solid #151d26;
      background:rgb(5 8 13/.94);
      backdrop-filter:blur(20px);
    }
    .il-product-brand{font-size:.88rem}
    .il-product-brand img{width:39px;height:20px}
    .il-product-account{
      width:38px;height:38px;padding:0!important;
      display:grid;place-items:center;
      border:1px solid #263240;
      border-radius:50%!important;
      background:#0d141c;
      color:transparent!important;
      font-size:0!important;
    }
    .il-product-account::before{
      content:"";
      width:18px;height:18px;
      border:1.8px solid #dce5ee;
      border-radius:50%;
      box-shadow:inset 0 -7px 0 -4px #dce5ee;
    }
    .il-device-head{
      margin:0 0 10px;
      padding:18px;
      border:1px solid #202b37;
      border-radius:26px;
      background:linear-gradient(155deg,rgb(22 140 255/.08),transparent 58%),#0b1118;
    }
    .il-back{margin-bottom:12px;font-size:.66rem}
    .il-title-row h1{font-size:2.2rem}
    .il-device-head p{max-width:320px;font-size:.72rem;line-height:1.5}
    .il-head-actions{display:none}
    .il-disclaimer{
      margin:0 0 12px;
      padding:12px 14px;
      border-color:#202b37;
      border-radius:18px;
      background:#0b1118;
      color:#8795a5;
    }
    .il-disclaimer strong{color:#dce5ee}
    .il-product-tabbar{
      position:fixed;
      left:50%;
      bottom:calc(12px + env(safe-area-inset-bottom,0px));
      z-index:120;
      width:min(356px,calc(100vw - 26px));
      min-height:62px;
      padding:5px 8px;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      border:1px solid rgb(160 190 217/.17);
      border-radius:999px;
      background:linear-gradient(180deg,rgb(255 255 255/.04),transparent),rgb(10 15 22/.94);
      box-shadow:0 20px 52px rgb(0 0 0/.46),inset 0 1px rgb(255 255 255/.055);
      transform:translateX(-50%);
      backdrop-filter:blur(24px) saturate(125%);
    }
    .il-product-tabbar>a{
      min-height:50px;
      display:grid;
      place-items:center;
      border-radius:999px;
      color:#7f8c9b;
    }
    .il-product-tabbar>a.is-active{background:rgb(255 255 255/.055);color:#fff}
    .il-product-tabbar svg{
      width:23px;height:23px;
      fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;
    }
    .il-product-tabbar-lab span{
      width:46px;height:34px;display:grid;place-items:center;border-radius:999px;background:rgb(22 140 255/.08)
    }
    .il-product-tabbar-lab img{width:36px;height:18px}
  }
</style>
