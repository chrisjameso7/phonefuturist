---
import Page from '../../layouts/Page.astro';
import '../../styles/labs.css';
const labs=[{number:'01',name:'Component economics',description:'Configure the components. Explore the bill of materials, retail pricing and margin.',href:'/labs/bom',tag:'BOM calculator'},{number:'02',name:'Performance under pressure',description:'A 15-minute thermal scenario. Shape the cooling system and inspect temperature and FPS.',href:'/labs/thermal',tag:'Thermal simulator'},{number:'03',name:'Make your call',description:'Choose a hardware design fork. Lock your prediction, then reveal the community view.',href:'/labs/vault',tag:'Concept vault'},{number:'04',name:'See the pulse',description:'Compare PWM frequency, duty cycle and DC dimming on a time-expanded waveform.',href:'/labs/display',tag:'Display comparator'},{number:'05',name:'Interactive Leaks',description:'Our existing device simulator: build concepts, compare generations and export results.',href:'/interactive-leaks',tag:'Device simulator'},{number:'06',name:'Make it feel like you',description:'Test tactile profiles, craft your own rhythm and download vibration packs and audio.',href:'/labs/haptics',tag:'Haptic playground'}];
---
<Page title="PhoneFuturist Labs"><div class="labs"><header class="lab-hero"><p class="lab-kicker">PhoneFuturist / Labs</p><h1>Tomorrow, in your hands.</h1><p>Build a concept. Push its limits. Make a prediction. One home for PhoneFuturist’s interactive hardware tools.</p></header><div class="lab-card-grid">{labs.map(lab=><a class="lab-glass lab-card" href={lab.href}><span class="lab-kicker">{lab.number} / {lab.tag}</span><h2>{lab.name}</h2><p>{lab.description}</p><span>Open lab ↗</span></a>)}</div></div></Page>
