---
import Page from '../../layouts/Page.astro';
import '../../components/studio/studio.css';
import type { StudioItem } from '../../lib/editorial';
const offset=Math.max(0,Math.min(100000,Number(Astro.url.searchParams.get('offset'))||0));
const {data,error}=await Astro.locals.supabase!.rpc('studio_read',{p_article:null,p_offset:offset});
const items=(data??[]) as StudioItem[];
const canWrite=Astro.locals.access!.roles.some(r=>['admin','writer','editor'].includes(r));
if(error){Astro.response.status=503;console.error('studio_list_failed',{code:error.code});}
---
<Page title="Studio" privatePage><div class="studio-workspace"><div class="studio-top"><div><p class="eyebrow">PhoneFuturist Studio</p><h1>The newsroom</h1></div>{canWrite&&<a class="button" href="/studio/new">Write an article</a>}</div><p>Draft, source, review and publish. Only approved revisions reach readers.</p>{error?<p role="alert">We could not load the newsroom. Reload this page to try again. Your saved drafts are unchanged.</p>:items.length===0?<section class="panel"><h2>No articles here yet.</h2><p>Start a draft with your original reporting. Nothing is published automatically.</p></section>:<ul class="studio-list">{items.map(item=><li><div><a href={'/studio/articles/'+item.id}>{item.title}</a><small>{item.section} · revision {item.current_revision} · {item.state.replaceAll('_',' ')}</small></div><span>{item.withdrawn?'Withdrawn':item.public_revision?'Has published revision':'Private'}</span></li>)}</ul>}<nav aria-label="Article pages">{offset>0&&<a href={'/studio?offset='+Math.max(0,offset-30)}>Previous</a>}{items.length===30&&<a href={'/studio?offset='+(offset+30)}>Next</a>}</nav><p><a href="/account">Account and MFA settings</a></p></div></Page>

