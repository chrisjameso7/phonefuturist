---
import Page from '../../layouts/Page.astro';
import '../../components/studio/studio.css';
import type { StudioItem } from '../../lib/editorial';
const offset=Math.max(0,Math.min(100000,Number(Astro.url.searchParams.get('offset'))||0));
const {data,error}=await Astro.locals.supabase!.rpc('studio_read',{p_article:null,p_offset:offset});
const items=(data??[]) as StudioItem[];
const canWrite=Astro.locals.access!.roles.some(r=>['admin','writer','editor','publisher'].includes(r));
if(error){Astro.response.status=503;console.error('studio_list_failed',{code:error.code});}
---
<Page title="Studio" privatePage>
  <div class="studio-shell">
    <aside class="studio-nav">
      <a class="studio-brand" href="/">
        <img src="/assets/phonefuturist-mark.svg" alt="" width="54" height="24" />
        <span>Studio</span>
      </a>

      <nav aria-label="Studio">
        <a class="is-active" href="/studio">Articles</a>
        {canWrite&&<a href="/studio/new">New article</a>}
        {Astro.locals.access?.can_manage_mfa_exceptions&&<a href="/studio/access">Studio access</a>}
        {Astro.locals.access?.roles.includes('admin')&&<a href="/studio/early-access">Lab Early Access</a>}
        <a href="/account">Account</a>
      </nav>

      <p class="studio-nav-note">PhoneFuturist newsroom tools</p>
    </aside>

    <section class="studio-workspace">
      <div class="studio-top">
        <div>
          <p class="eyebrow">PhoneFuturist Studio</p>
          <h1>Articles</h1>
          <p class="studio-help">Write, manage and publish from one focused newsroom workspace.</p>
        </div>
        {canWrite&&<a class="button" href="/studio/new">+ New article</a>}
      </div>

      <div class="studio-filterbar">
        <span>All articles</span>
        <span>{items.length} on this page</span>
      </div>

      {error
        ? <p class="studio-message" role="alert">We could not load the newsroom. Reload this page to try again. Your saved drafts are unchanged.</p>
        : items.length===0
          ? <section class="studio-empty-state"><p class="eyebrow">Newsroom</p><h2>No articles yet.</h2><p>Start with original reporting. Nothing is published automatically.</p>{canWrite&&<a class="button" href="/studio/new">Write the first article</a>}</section>
          : <div class="studio-article-table">
              {items.map(item=><a class="studio-article-row" href={'/studio/articles/'+item.id}>
                <div>
                  <strong>{item.title}</strong>
                  <small>{item.section} · revision {item.current_revision}</small>
                </div>
                <div class="studio-row-meta">
                  <span>{item.state.replaceAll('_',' ')}</span>
                  <b>{item.withdrawn?'Withdrawn':item.public_revision?'Published':'Private'}</b>
                </div>
              </a>)}
            </div>
      }

      <nav class="studio-pagination" aria-label="Article pages">
        {offset>0&&<a href={'/studio?offset='+Math.max(0,offset-30)}>← Previous</a>}
        {items.length===30&&<a href={'/studio?offset='+(offset+30)}>Next →</a>}
      </nav>
    </section>
  </div>
</Page>
