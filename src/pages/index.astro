---
import Page from '../layouts/Page.astro';
import { publishedArticles } from '../lib/publication';

const { articles, unavailable } = await publishedArticles();
const latest = articles.filter((article) => !article.withdrawn).slice(0, 8);

function safeHttps(url?: string | null) {
  if (!url) return false;
  try { return new URL(url).protocol === 'https:'; } catch { return false; }
}

function articleImage(article: any) {
  if (article?.card_image && safeHttps(article.card_image.url)) return article.card_image;
  return article?.blocks?.find((block: any) => block.type === 'image' && safeHttps(block.url)) ?? null;
}
---

<Page title="What's next" home>
  <div class="pf-network">
    <aside class="pf-left-rail" aria-label="Browse PhoneFuturist">
      <div class="pf-rail-title">Browse</div>
      <nav>
        <a class="is-active" href="/">Home</a>
        <a href="/articles">Newsroom</a>
        <a href="/articles?section=news">News</a>
        <a href="/articles?section=leaks">Leaks</a>
        <a href="/articles?section=analysis">Analysis</a>
        <a href="/articles?section=reports">Reports</a>
      </nav>
    </aside>

    <main class="pf-feed" aria-label="PhoneFuturist feed">
      <header class="pf-feed-head">
        <div>
          <p class="eyebrow">PhoneFuturist</p>
          <h1>What's next.</h1>
        </div>
        <a href="/articles">All stories</a>
      </header>

      <nav class="pf-feed-tabs" aria-label="Feed sections">
        <a class="is-active" href="/">For you</a>
        <a href="/articles?section=news">News</a>
        <a href="/articles?section=leaks">Leaks</a>
        <a href="/articles?section=analysis">Analysis</a>
      </nav>


      <nav class="pf-mobile-topics" aria-label="Quick topics">
        <a class="is-active" href="/">
          <span class="pf-topic-circle pf-topic-add">+</span>
          <small>Your feed</small>
        </a>
        <a href="/articles?section=news">
          <span class="pf-topic-circle pf-topic-news">N</span>
          <small>News</small>
        </a>
        <a href="/articles?section=leaks">
          <span class="pf-topic-circle pf-topic-leaks">L</span>
          <small>Leaks</small>
        </a>
        <a href="/articles?section=reports">
          <span class="pf-topic-circle pf-topic-phone">R</span>
          <small>Reports</small>
        </a>
        <a href="/articles?section=analysis">
          <span class="pf-topic-circle pf-topic-lab">A</span>
          <small>Analysis</small>
        </a>
        <a href="/account">
          <span class="pf-topic-circle pf-topic-creators">C</span>
          <small>Creators</small>
        </a>
      </nav>

      <section class="pf-feature">
        <img src="/assets/device-concept.png" alt="" width="1672" height="941" fetchpriority="high" />
        <div class="pf-feature-scrim"></div>
        <div class="pf-feature-topline">
          <span>★ Featured</span>
          <small>PhoneFuturist Newsroom</small>
        </div>
        <div class="pf-feature-copy">
          <span>Phones</span>
          <h2>The future of technology deserves better reporting.</h2>
          <p>News, leaks, reports and analysis focused on what is changing next and why it matters.</p>
          <div>
            <a class="button" href="/articles">Read the latest</a>
            <a class="pf-text-action" href="/articles?section=leaks">Browse leaks</a>
          </div>
        </div>
      </section>

      <div class="pf-feed-label">
        <span>Latest</span>
        <small>Fresh from the newsroom</small>
      </div>

      {latest.length ? (
        <section class="pf-story-feed">
          {latest.map((article) => {
            const image = articleImage(article);
            return <article class="pf-story">
              <div class="pf-story-main">
                <div class="pf-story-social"><span>PhoneFuturist</span><b>•••</b></div>
                <div class="pf-story-meta">
                  <span>{article.section}</span>
                  <time datetime={article.published_at}>
                    {new Date(article.published_at).toLocaleDateString('en-GB',{day:'numeric',month:'short',timeZone:'UTC'})}
                  </time>
                </div>
                <h2><a href={article.canonical_path}>{article.title}</a></h2>
                <p>{article.summary}</p>
                <div class="pf-story-byline">{article.byline}</div>
              </div>
              {image && <a class="pf-story-image" href={article.canonical_path} aria-label={`Read ${article.title}`}>
                <img src={image.url} alt={image.alt ?? ''} loading="lazy" decoding="async" />
              </a>}
            </article>;
          })}
        </section>
      ) : (
        <section class="pf-feed-empty">
          <p class="eyebrow">Newsroom</p>
          <h2>{unavailable ? 'Reporting is temporarily unavailable.' : 'The feed starts here.'}</h2>
          <p>{unavailable ? 'Please check back shortly.' : 'New reporting will appear here as it is published.'}</p>
        </section>
      )}
    </main>

    <aside class="pf-right-rail">

      <section class="pf-side-panel">
        <div class="pf-side-head"><span>Quick access</span></div>
        <a class="pf-quick-link" href="/articles?section=leaks"><span>Leaks</span><b>→</b></a>
        <a class="pf-quick-link" href="/articles?section=analysis"><span>Analysis</span><b>→</b></a>
      </section>

      <section class="pf-side-note">
        <span class="eyebrow">PhoneFuturist</span>
        <p>Independent technology reporting, leaks, reports and analysis.</p>
      </section>
    </aside>
  </div>
</Page>

<style>
  .home-page{max-width:none!important;padding:0!important}
  .pf-network{width:min(100%,1480px);margin:0 auto;padding:18px clamp(14px,2vw,28px) 70px;display:grid;grid-template-columns:210px minmax(0,760px) 290px;gap:22px;align-items:start}
  .pf-left-rail,.pf-right-rail{position:sticky;top:92px}
  .pf-left-rail{display:grid;gap:20px}
  .pf-rail-title{padding:0 10px;color:#667587;font-size:.6rem;font-weight:760;letter-spacing:.12em;text-transform:uppercase}
  .pf-left-rail nav{display:grid;gap:3px}
  .pf-left-rail nav a{display:flex;align-items:center;justify-content:space-between;padding:10px 11px;border-radius:9px;color:#8d9aaa;text-decoration:none;font-size:.76rem}
  .pf-left-rail nav a:hover,.pf-left-rail nav a.is-active{color:#fff;background:#0e151e}
  .pf-left-rail nav a.is-active{box-shadow:inset 2px 0 #168cff}
  .pf-rail-lab span{padding:2px 5px;border-radius:999px;background:rgb(22 140 255/.13);color:#59c7ff;font-size:.52rem;text-transform:uppercase}
  .pf-rail-card{padding:14px;border:1px solid #1f2b38;border-radius:14px;background:linear-gradient(150deg,rgb(22 140 255/.08),transparent 60%),#0b121a}
  .pf-rail-card img{width:34px;height:20px;margin-bottom:12px}
  .pf-rail-card strong{display:block;font-size:.83rem;line-height:1.3}
  .pf-rail-card p{margin:7px 0 12px;color:#718092;font-size:.68rem;line-height:1.5}
  .pf-rail-card a{color:#62cfff;text-decoration:none;font-size:.66rem;font-weight:700}

  .pf-feed{min-width:0;border-inline:1px solid #1d2834}
  .pf-feed-head{display:flex;align-items:end;justify-content:space-between;padding:20px 22px 18px}
  .pf-feed-head h1{margin:4px 0 0;font-size:clamp(2.2rem,4vw,3.8rem);line-height:.95;letter-spacing:-.06em;font-weight:620}
  .pf-feed-head>a{color:#8190a1;text-decoration:none;font-size:.67rem}
  .pf-feed-tabs{display:flex;gap:4px;padding:0 16px 12px;border-bottom:1px solid #1d2834;overflow-x:auto}
  .pf-feed-tabs a{flex:0 0 auto;padding:8px 11px;border-radius:8px;color:#778697;text-decoration:none;font-size:.68rem}
  .pf-feed-tabs a:hover,.pf-feed-tabs a.is-active{color:#fff;background:#101821}
  .pf-feed-tabs a.is-active{box-shadow:inset 0 -1px #168cff}

  .pf-feature{position:relative;min-height:390px;margin:16px;border:1px solid #202c39;border-radius:18px;overflow:hidden;background:#071018}
  .pf-feature>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pf-feature-scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgb(4 9 14/.96) 0%,rgb(4 9 14/.78) 48%,rgb(4 9 14/.14) 100%),linear-gradient(0deg,rgb(4 9 14/.65),transparent 55%)}
  .pf-feature-copy{position:relative;z-index:1;max-width:520px;padding:48px 36px}
  .pf-feature-copy>span{color:#2cd9ff;font-size:.58rem;font-weight:760;letter-spacing:.13em;text-transform:uppercase}
  .pf-feature-copy h2{margin:10px 0 12px;font-size:clamp(2rem,4vw,3.7rem);line-height:.95;letter-spacing:-.055em;font-weight:620}
  .pf-feature-copy p{max-width:450px;color:#a6b2bf;font-size:.86rem;line-height:1.62}
  .pf-feature-copy>div{display:flex;align-items:center;gap:15px;margin-top:22px}
  .pf-text-action{color:#c2ceda;text-decoration:none;font-size:.7rem}

  .pf-feed-label{display:flex;align-items:center;justify-content:space-between;padding:16px 22px 10px;border-top:1px solid #1d2834}
  .pf-feed-label span{font-size:.75rem;font-weight:740}
  .pf-feed-label small{color:#647384;font-size:.61rem}
  .pf-story-feed{display:grid}
  .pf-story{display:grid;grid-template-columns:minmax(0,1fr) 170px;gap:20px;padding:22px;border-top:1px solid #1d2834;transition:background .15s}
  .pf-story:hover{background:#090f16}
  .pf-story-meta{display:flex;gap:10px;align-items:center;color:#657486;font-size:.59rem;text-transform:uppercase;letter-spacing:.08em}
  .pf-story-meta span{color:#2cd9ff}
  .pf-story h2{margin:8px 0 7px;font-size:1.3rem;line-height:1.15;letter-spacing:-.035em}
  .pf-story h2 a{color:#eef4fa;text-decoration:none}
  .pf-story p{margin:0;color:#8a98a8;font-size:.75rem;line-height:1.55}
  .pf-story-byline{margin-top:13px;color:#657486;font-size:.61rem}
  .pf-story-image{display:block;aspect-ratio:4/3;border:1px solid #202c39;border-radius:12px;overflow:hidden;background:#0b1118}
  .pf-story-image img{width:100%;height:100%;object-fit:cover;transition:transform .2s}
  .pf-story:hover .pf-story-image img{transform:scale(1.025)}
  .pf-feed-empty{margin:16px;padding:48px 26px;border:1px solid #202c39;border-radius:16px;background:#0b121a}
  .pf-feed-empty h2{margin:5px 0;font-size:2rem}
  .pf-feed-empty p:not(.eyebrow){color:#7d8b9b}

  .pf-right-rail{display:grid;gap:14px}
  .pf-side-panel,.pf-side-note{padding:16px;border:1px solid #1f2b38;border-radius:14px;background:#0b121a}
  .pf-side-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;color:#718092;font-size:.6rem;font-weight:760;letter-spacing:.09em;text-transform:uppercase}
  .pf-side-head a{color:#59c7ff;text-decoration:none;font-size:.58rem}
  .pf-side-panel>strong{display:block;font-size:1rem}
  .pf-side-panel>p{margin:3px 0 12px;color:#657486;font-size:.67rem}
  .pf-side-panel dl{display:grid;margin:0}
  .pf-side-panel dl div{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-top:1px solid #1d2834}
  .pf-side-panel dt{color:#657486;font-size:.62rem}
  .pf-side-panel dd{margin:0;color:#bdc8d4;font-size:.64rem}
  .pf-side-cta{display:block;margin-top:12px;padding:9px 10px;border-radius:8px;background:rgb(22 140 255/.1);color:#62cfff;text-decoration:none;font-size:.66rem;text-align:center}
  .pf-quick-link{display:flex;justify-content:space-between;gap:10px;padding:11px 0;border-top:1px solid #1d2834;color:#aab6c3;text-decoration:none;font-size:.69rem}
  .pf-quick-link b{color:#4eaefb}
  .pf-side-note p{margin:7px 0 0;color:#8190a1;font-size:.7rem;line-height:1.5}

  @media(max-width:1150px){.pf-network{grid-template-columns:190px minmax(0,1fr)}.pf-right-rail{display:none}}
  @media(max-width:820px){.pf-network{display:block;padding-inline:0}.pf-left-rail{display:none}.pf-feed{border-inline:0}.pf-feed-head{padding-inline:18px}.pf-feature{margin:12px}.pf-story{padding-inline:18px}}
  @media(max-width:560px){
    .pf-network{padding-bottom:0!important}
    .pf-feed-head{padding:18px 16px 10px!important}
    .pf-feed-head h1{font-size:2.2rem;line-height:.98}
    .pf-feed-tabs{padding:0 8px 8px!important;gap:1px}
    .pf-feed-tabs a{padding:8px 10px}
    .pf-feature{min-height:320px;margin:0!important;border-inline:0;border-radius:0!important}
    .pf-feature-copy{padding:28px 20px}
    .pf-feature-copy h2{font-size:2rem;line-height:.98}
    .pf-feature-copy p{font-size:.79rem;line-height:1.5}
    .pf-feature-copy>div{margin-top:18px}
    .pf-feed-label{padding:14px 16px 9px}
    .pf-story{grid-template-columns:minmax(0,1fr) 96px;gap:12px;padding:16px}
    .pf-story h2{font-size:1rem}
    .pf-story p{display:none}
    .pf-story-image{align-self:start;border-radius:9px}
  }
</style>

<style>
  .pf-mobile-topics{display:none}
  .pf-feature-topline{display:none}

  @media(max-width:560px){
    .pf-feed-head{display:none!important}
    .pf-feed-tabs{display:none!important}

    .pf-mobile-topics{
      display:flex;
      gap:14px;
      padding:16px 14px 14px;
      overflow-x:auto;
      scrollbar-width:none;
      border-bottom:0;
    }
    .pf-mobile-topics::-webkit-scrollbar{display:none}
    .pf-mobile-topics a{
      flex:0 0 auto;
      width:58px;
      display:grid;
      justify-items:center;
      gap:7px;
      color:#cbd5df;
      text-decoration:none;
      font-size:.61rem;
    }
    .pf-topic-circle{
      width:54px;
      height:54px;
      display:grid;
      place-items:center;
      border:2px solid #2b3948;
      border-radius:50%;
      background:
        radial-gradient(circle at 30% 20%,rgb(44 217 255/.16),transparent 42%),
        #111821;
      color:#fff;
      font-size:.9rem;
      font-weight:780;
      box-shadow:inset 0 0 0 2px #080d13;
    }
    .pf-mobile-topics .is-active .pf-topic-circle,
    .pf-mobile-topics a:hover .pf-topic-circle{border-color:#28c8ff}
    .pf-topic-add{font-size:1.5rem;font-weight:380}
    .pf-topic-news{background:linear-gradient(145deg,#193651,#0d151e)}
    .pf-topic-leaks{background:linear-gradient(145deg,#2d224c,#0e1118)}
    .pf-topic-phone{background:linear-gradient(145deg,#193144,#111820)}
    .pf-topic-creators{background:linear-gradient(145deg,#3a2531,#111820)}
    .pf-topic-lab img{width:34px;height:18px;object-fit:contain}

    .pf-feature{
      min-height:450px!important;
      margin:2px 12px 14px!important;
      border:1px solid #243140!important;
      border-radius:26px!important;
      box-shadow:0 18px 44px rgb(0 0 0/.22);
    }
    .pf-feature-scrim{
      background:
        linear-gradient(0deg,rgb(4 9 14/.94) 0%,rgb(4 9 14/.58) 48%,rgb(4 9 14/.16) 72%),
        linear-gradient(90deg,rgb(4 9 14/.34),transparent 70%)!important;
    }
    .pf-feature-topline{
      position:absolute;
      z-index:2;
      top:16px;
      left:16px;
      right:16px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
    }
    .pf-feature-topline span{
      padding:7px 11px;
      border:1px solid rgb(44 217 255/.38);
      border-radius:999px;
      background:rgb(8 19 29/.72);
      color:#8cecff;
      font-size:.56rem;
      font-weight:780;
      letter-spacing:.08em;
      text-transform:uppercase;
      backdrop-filter:blur(12px);
    }
    .pf-feature-topline small{color:#c2ccd6;font-size:.58rem}
    .pf-feature-copy{
      position:absolute!important;
      inset:auto 0 0!important;
      max-width:none!important;
      padding:28px 20px 22px!important;
    }
    .pf-feature-copy>span{font-size:.62rem}
    .pf-feature-copy h2{
      max-width:340px;
      margin:8px 0 10px;
      font-size:2.18rem!important;
      line-height:.96!important;
      letter-spacing:-.055em;
    }
    .pf-feature-copy p{
      max-width:320px;
      margin:0;
      font-size:.78rem!important;
      color:#b7c2ce;
    }
    .pf-feature-copy>div{margin-top:18px!important}
    .pf-feature-copy .button{
      padding:11px 17px;
      border-radius:999px;
      box-shadow:0 0 0 1px rgb(255 255 255/.05),0 8px 24px rgb(22 140 255/.18);
    }

    .pf-feed-label{
      margin:0 12px;
      padding:15px 4px 9px!important;
      border-top:0!important;
    }
    .pf-feed-label span{font-size:.78rem}
    .pf-feed-label small{font-size:.58rem}

    .pf-story-feed{
      gap:10px;
      padding:0 12px 10px;
    }
    .pf-story{
      position:relative;
      grid-template-columns:112px minmax(0,1fr)!important;
      gap:14px!important;
      padding:12px!important;
      border:1px solid #202b37!important;
      border-radius:22px!important;
      background:#0b1118!important;
      overflow:hidden;
    }
    .pf-story-main{grid-column:2}
    .pf-story-image{
      grid-column:1;
      grid-row:1;
      width:112px;
      aspect-ratio:1/1!important;
      border:0!important;
      border-radius:16px!important;
      align-self:stretch!important;
    }
    .pf-story-social{
      display:flex;
      justify-content:space-between;
      gap:10px;
      margin-bottom:5px;
      color:#758497;
      font-size:.54rem;
    }
    .pf-story-social b{letter-spacing:.12em}
    .pf-story-meta{gap:7px;font-size:.51rem}
    .pf-story h2{
      margin:6px 0 5px!important;
      font-size:.96rem!important;
      line-height:1.13!important;
    }
    .pf-story p{display:-webkit-box!important;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:.65rem;line-height:1.42}
    .pf-story-byline{display:none}
  }
</style>


<style>
/* MOBILE SINGLE CANVAS FIX
   One continuous app background. No page-inside-page shell. */
@media(max-width:560px){
  html,
  body,
  body:not(.product-mode),
  body:not(.product-mode) main.home-page,
  .home-page,
  .pf-network,
  .pf-feed{
    background:#05080d!important;
  }

  .pf-network{
    width:100%!important;
    max-width:none!important;
    margin:0!important;
    padding:0 0 88px!important;
    border:0!important;
    border-radius:0!important;
    box-shadow:none!important;
    overflow:visible!important;
  }

  .pf-feed{
    margin:0!important;
    padding:0!important;
    border:0!important;
    border-radius:0!important;
    box-shadow:none!important;
  }

  .pf-mobile-topics{
    margin:0!important;
    background:transparent!important;
    border:0!important;
    border-radius:0!important;
    box-shadow:none!important;
  }

  .pf-feature{
    border:0!important;
    box-shadow:none!important;
  }

  .pf-feed-label,
  .pf-story-feed{
    background:transparent!important;
    border:0!important;
  }
}
</style>
