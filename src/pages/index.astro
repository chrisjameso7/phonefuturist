---
import NewsletterSignup from '../components/NewsletterSignup.astro';
import Page from '../layouts/Page.astro';
import EditorialHomepage from '../components/EditorialHomepage.astro';
import { publishedArticles } from '../lib/publication';
const {articles}=await publishedArticles();
---
<Page title="Technology, examined" home newsletterInContent>
 <EditorialHomepage articles={articles}>
  <nav class="pf-home-paths" aria-label="Explore PhoneFuturist">
   <a class="pf-home-path" href="/articles"><span>01 / Stories</span><strong>Read the latest</strong></a>
   <a class="pf-home-path" href="/interactive-leaks"><span>02 / Interactive Leaks</span><strong>Build a device</strong></a>
   <a class="pf-home-path" href="/interactive-leaks/explore"><span>03 / Community</span><strong>Explore builds</strong></a>
  </nav>
  <nav class="coverage-links" aria-label="Coverage sections">{['news','reports','leaks','analysis'].map(section=><a href={'/articles?section='+section}>{section}</a>)}<a href="/about">About PhoneFuturist</a></nav>
  <NewsletterSignup/>
 </EditorialHomepage>
</Page>
<style>
.pf-home-paths{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;padding-block:24px;border-block:1px solid var(--pf-border);margin:8px 0 0}.pf-home-path{display:flex;flex-direction:column;gap:12px;min-width:0;min-height:100px;padding:18px!important;box-sizing:border-box;color:var(--pf-primary);text-decoration:none;border:1px solid var(--pf-border);background:transparent;border-radius:0}.pf-home-path span{font-size:11px;color:var(--pf-secondary);line-height:1.5;letter-spacing:.04em}.pf-home-path strong{font-size:1rem;line-height:1.4}.coverage-links{display:flex;flex-wrap:wrap;gap:8px 24px;padding-block:16px}.coverage-links a{display:inline-flex;align-items:center;min-height:44px;text-transform:capitalize;font-size:.9rem}
@media(max-width:600px){.pf-home-paths{grid-template-columns:minmax(0,1fr);gap:0}.pf-home-path{flex-direction:row;justify-content:space-between;align-items:center;gap:18px;min-height:72px!important;padding:16px 0!important}.pf-home-path span{max-width:48%}.pf-home-path strong{text-align:right;max-width:48%}}
</style>
