---
import Page from '../layouts/Page.astro';
import { publishedArticles } from '../lib/publication';
import ArticleCards from '../components/ArticleCards.astro';
import SponsoredSpotlight from '../components/SponsoredSpotlight.astro';
const {articles,unavailable}=await publishedArticles();
const latest=articles.filter(a=>!a.withdrawn).slice(0,4);
---
<Page title="Technology, examined" home>
<div class="pf-home-v2 pf-ui">
  <SponsoredSpotlight />
  <nav class="pf-home-paths" aria-label="Explore PhoneFuturist">
    <a class="pf-home-path" href="/articles"><span>01 / Stories</span><strong>Read the latest ↗</strong></a>
    <a class="pf-home-path" href="/interactive-leaks"><span>02 / Interactive Leaks</span><strong>Build a device ↗</strong></a>
    <a class="pf-home-path" href="/community"><span>03 / Community</span><strong>Explore builds ↗</strong></a>
  </nav>
<section id="latest" class="latest-section"><div class="latest-main"><div class="section-heading"><div><h2>The latest</h2><p>Top stories, in context.</p></div><a href="/articles">View all articles →</a></div>{latest.length ? <ArticleCards articles={latest}/> : <div class="empty-news"><span class="eyebrow">The newsroom</span><h3>{unavailable?'Reporting is temporarily unavailable.':'Our first stories start here.'}</h3><p>{unavailable?'Please check back shortly.':'Original reporting takes work. Our writers are preparing original stories.'}</p><a href="#about">Our editorial approach ↗</a></div>}</div><aside class="news-rail"><div class="rail-panel"><h3>Explore the coverage</h3>{[['01','News','What happened. Why it matters.','news'],['02','Reports','A closer look at the evidence.','reports'],['03','Leaks','Rumors, with their sources.','leaks'],['04','Analysis','The context behind the headlines.','analysis']].map(([n,t,d,s])=><a class="coverage-row" href={'/articles?section='+s}><span>{n}</span><div><strong>{t}</strong><small>{d}</small></div><b aria-hidden="true">↗</b></a>)}</div><div class="rail-panel brief"><span class="eyebrow">Your next perspective</span><h3>{Astro.locals.user ? "Welcome back." : "Make yourself at home."}</h3><p>{Astro.locals.user ? "Your profile, saved builds and account settings, all in one place." : "One PhoneFuturist account. Start with the stories."}</p><a class="button" href={Astro.locals.user ? "/account" : "/join"}>{Astro.locals.user ? "Your account →" : "Create an account →"}</a></div></aside></section>
<section class="about-section" id="about"><div><p class="eyebrow">Independent thinking. Informed perspective.</p><h2>Technology moves fast.<br/><span>Understanding goes deeper.</span></h2></div><div><p>PhoneFuturist covers smartphones, laptops, chips, displays, cameras and software — with original reporting and structured sourcing.</p><p>We separate what is confirmed from what is claimed. Sources and corrections belong alongside the story, where readers can see them.</p><a class="text-link" href="/articles">Meet your next read →</a></div></section>

</div>
</Page>
