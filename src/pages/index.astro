---
import Page from '../layouts/Page.astro';
import { publishedArticles } from '../lib/publication';
import ArticleCards from '../components/ArticleCards.astro';

const { articles, unavailable } = await publishedArticles();
const latest = articles.filter((article) => !article.withdrawn).slice(0, 4);
---

<Page title="Technology, examined" home>
  <section class="observatory" aria-label="Main content">
    <section class="hero" aria-labelledby="hero-title" data-theme-support>
      <img
        class="hero-image"
        src="/assets/device-concept.png"
        alt="Concept device illustrating the next era of technology"
        width="1672"
        height="941"
        fetchpriority="high"
      />

      <div class="hero-copy" style="--accent-color: var(--accent)">
        <p class="eyebrow" style="color: var(--muted)">Technology, examined</p>

        <h1 id="hero-title" style="--accent-color: var(--accent)">
          The next era.<br />
          <span>Under the lens.</span>
        </h1>

        <p class="hero-intro" style="color: var(--muted)">
          Independent technology journalism, deep analysis and everything in
          between. The devices, the silicon and the ideas that move the world
          forward.
        </p>

        <div class="hero-actions" style="--accent-color: var(--accent)">
          <a class="button button-white" href="#latest">
            Explore the latest →
          </a>

          <a class="button button-outline" href="#about">
            About PhoneFuturist
          </a>
        </div>
      </div>

      <div class="hero-caption" style="--accent-color: var(--accent)">
        <p class="eyebrow" style="color: var(--muted)">Beyond the surface</p>

        <h2>
          Every detail.<br />
          A bigger picture.
        </h2>

        <p style="color: var(--muted)">
          From the glass to the silicon, understanding what comes next starts
          with asking better questions.
        </p>

        <a href="/articles" style="color: var(--accent)">Explore our reporting ↗</a>
      </div>

      <small class="image-disclosure" style="color: var(--muted)">
        Concept illustration · AI-generated
      </small>
    </section>
  </section>

  <section id="latest" class="latest-section" style="--accent-color: var(--accent)">
    <div class="latest-main" style="--accent-color: var(--accent)">
      <div class="section-heading" style="--accent-color: var(--accent)">
        <div>
          <p class="eyebrow" style="color: var(--muted)">The newsroom</p>
          <h2>The latest</h2>
          <p style="color: var(--muted)">Top stories, in context.</p>
        </div>

        <a href="/articles" style="color: var(--accent)">View all ↗</a>
      </div>

      <nav class="section-tabs home-section-tabs" aria-label="Browse coverage" style="--accent-color: var(--accent)">
        <a href="/articles?section=news">News</a>
        <a href="/articles?section=reports">Reports</a>
        <a href="/articles?section=leaks">Leaks</a>
        <a href="/articles?section=analysis">Analysis</a>
      </nav>

      {
        latest.length ? (
          <ArticleCards articles={latest} />
        ) : (
          <div class="empty-news" style="--accent-color: var(--accent)">
            <span class="eyebrow" style="color: var(--muted)">The newsroom</span>

            <h3>
              {
                unavailable
                  ? 'Reporting is temporarily unavailable.'
                  : 'Our first stories start here.'
              }
            </h3>

            <p style="color: var(--muted)">
              {
                unavailable
                  ? 'Please check back shortly.'
                  : 'Original reporting takes work. Our writers are preparing original stories.'
              }
            </p>

            <a href="#about" style="color: var(--accent)">Our editorial approach ↗</a>
          </div>
        )
      }
    </div>
  </section>

  <section class="home-lab" style="--accent-color: var(--accent)">
    <div class="home-lab-copy" style="--accent-color: var(--accent)">
      <p class="eyebrow" style="color: var(--muted)">Interactive Leaks</p>

      <h2>
        Don't just read the rumor.<br />
        <span>Test what it could mean.</span>
      </h2>

      <p style="color: var(--muted)">
        Configure rumored hardware and explore the trade-offs with
        PhoneFuturist's deterministic device simulator.
      </p>
    </div>

    <div class="home-lab-action" style="--accent-color: var(--accent)">
      <span class="home-lab-mark" aria-hidden="true">PF / Lab</span>
      <a class="button" href="/interactive-leaks" style="--accent-color: var(--accent)">Enter The Lab ↗</a>
    </div>
  </section>

  <section class="about-section" id="about" style="--accent-color: var(--accent)">
    <div style="--accent-color: var(--accent)">
      <p class="eyebrow" style="color: var(--muted)">Independent thinking. Informed perspective.</p>

      <h2 style="--accent-color: var(--accent)">
        Technology moves fast.<br />
        <span>Understanding goes deeper.</span>
      </h2>
    </div>

    <div style="--accent-color: var(--accent)">
      <p style="color: var(--muted)">
        PhoneFuturist covers smartphones, laptops, chips, displays, cameras
        and software, with original reporting and structured sourcing.
      </p>

      <p style="color: var(--muted)">
        We separate what is confirmed from what is claimed. Sources and
        corrections belong alongside the story, where readers can see them.
      </p>

      <a class="text-link" href="/articles" style="color: var(--accent)">Meet your next read →</a>
    </div>
  </section>
</Page>