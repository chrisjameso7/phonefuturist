---
import Page from '../layouts/Page.astro';
import EditorialHomepage from '../components/EditorialHomepage.astro';
import { publishedArticles } from '../lib/publication';

const { articles } = await publishedArticles();
const signedIn = Boolean(Astro.locals.user);
---
<Page title="Technology, examined" home>
  <EditorialHomepage articles={articles}>
  <nav class="pf-home-paths" aria-label="Explore PhoneFuturist">
    <a class="pf-home-path" href="/articles"><span>01 / Stories</span><strong>Read the latest ↗</strong></a>
    <a class="pf-home-path" href="/interactive-leaks"><span>02 / Interactive Leaks</span><strong>Build a device ↗</strong></a>
    <a class="pf-home-path" href="/interactive-leaks/explore"><span>03 / Community</span><strong>Explore builds ↗</strong></a>
  </nav>
    <aside class="homepage-reader-links" aria-label="Coverage and account">
<div class="rail-panel"><h3>Explore the coverage</h3>{[['01','News','What happened. Why it matters.','news'],['02','Reports','A closer look at the evidence.','reports'],['03','Leaks','Rumors, with their sources.','leaks'],['04','Analysis','The context behind the headlines.','analysis']].map(([n,t,d,s])=><a class="coverage-row" href={'/articles?section='+s}><span>{n}</span><div><strong>{t}</strong><small>{d}</small></div><b aria-hidden="true">↗</b></a>)}</div><div class="rail-panel brief"><span class="eyebrow">Your next perspective</span><h3>{signedIn ? 'Welcome back.' : 'Make yourself at home.'}</h3><p>{signedIn ? 'Manage your profile and saved builds.' : 'One PhoneFuturist account. Start with the stories.'}</p>{signedIn ? <a class="button" href="/account">My account →</a> : <a class="button" href="/join">Create an account →</a>}</div>
    </aside>
<section class="about-section" id="about"><div><p class="eyebrow">Independent thinking. Informed perspective.</p><h2>Technology moves fast.<br/><span>Understanding goes deeper.</span></h2></div><div><p>PhoneFuturist covers smartphones, laptops, chips, displays, cameras and software — with original reporting and structured sourcing.</p><p>We separate what is confirmed from what is claimed. Sources and corrections belong alongside the story, where readers can see them.</p><a class="text-link" href="/about">About PhoneFuturist →</a></div></section>
  </EditorialHomepage>
</Page>
<style>
  .homepage-reader-links {display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:24px;padding-block:24px;border-top:1px solid var(--pf-border)}
  .homepage-reader-links :global(.rail-panel) {background:transparent;border:0;border-radius:0;padding:0}
  @media(max-width:760px) {.homepage-reader-links {grid-template-columns:1fr}}
</style>
