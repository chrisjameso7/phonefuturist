---
import Page from '../layouts/Page.astro';
import { publishedArticles } from '../lib/publication';
import ArticleCards from '../components/ArticleCards.astro';

const { articles, unavailable } = await publishedArticles();
const latest = articles.filter((article) => !article.withdrawn).slice(0, 4);
---

<Page title="Technology, examined" home>
  <section class="observatory">
    <section class="hero" aria-labelledby="hero-title">
      <img
        class="hero-image"
        src="/assets/device-concept.png"
        alt=""
        width="1672"
        height="941"
        fetchpriority="high"
      />

      <div class="hero-copy">
        <p class="eyebrow">Technology, examined</p>

        <h1 id="hero-title">
          The next era.<br />
          <span>Under the lens.</span>
        </h1>

        <p class="hero-intro">
          Independent technology journalism, deep analysis and everything in
          between. The devices, the silicon and the ideas that move the world
          forward.
        </p>

        <div class="hero-actions">
          <a class="button button-white" href="#latest">
            Explore the latest →
          </a>

          <a class="button button-outline" href="#about">
            About PhoneFuturist
          </a>
        </div>
      </div>

      <div class="hero-caption">
        <p class="eyebrow">Beyond the surface</p>

        <h2>
          Every detail.<br />
          A bigger picture.
        </h2>

        <p>
          From the glass to the silicon, understanding what comes next starts
          with asking better questions.
        </p>

        <a href="/articles">Explore our reporting ↗</a>
      </div>

      <small class="image-disclosure">
        Concept illustration · AI-generated
      </small>
    </section>
  </section>

  <section id="latest" class="latest-section">
    <div class="latest-main">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The newsroom</p>
          <h2>The latest</h2>
          <p>Top stories, in context.</p>
        </div>

        <a href="/articles">View all ↗</a>
      </div>

      <nav class="section-tabs home-section-tabs" aria-label="Browse coverage">
        <a href="/articles?section=news">News</a>
        <a href="/articles?section=reports">Reports</a>
        <a href="/articles?section=leaks">Leaks</a>
        <a href="/articles?section=analysis">Analysis</a>
      </nav>

      {
        latest.length ? (
          <ArticleCards articles={latest} />
        ) : (
          <div class="empty-news">
            <span class="eyebrow">The newsroom</span>

            <h3>
              {
                unavailable
                  ? 'Reporting is temporarily unavailable.'
                  : 'Our first stories start here.'
              }
            </h3>

            <p>
              {
                unavailable
                  ? 'Please check back shortly.'
                  : 'Original reporting takes work. Our writers are preparing original stories.'
              }
            </p>

            <a href="#about">Our editorial approach ↗</a>
          </div>
        )
      }
    </div>
  </section>

  <section class="home-lab">
    <div class="home-lab-copy">
      <p class="eyebrow">Interactive Leaks</p>

      <h2>
        Don't just read the rumor.<br />
        <span>Test what it could mean.</span>
      </h2>

      <p>
        Configure rumored hardware and explore the trade-offs with
        PhoneFuturist's deterministic device simulator.
      </p>
    </div>

    <div class="home-lab-action">
      <span class="home-lab-mark" aria-hidden="true">PF / Lab</span>
      <a class="button" href="/interactive-leaks">Enter The Lab ↗</a>
    </div>
  </section>

  <section class="about-section" id="about">
    <div>
      <p class="eyebrow">Independent thinking. Informed perspective.</p>

      <h2>
        Technology moves fast.<br />
        <span>Understanding goes deeper.</span>
      </h2>
    </div>

    <div>
      <p>
        PhoneFuturist covers smartphones, laptops, chips, displays, cameras
        and software, with original reporting and structured sourcing.
      </p>

      <p>
        We separate what is confirmed from what is claimed. Sources and
        corrections belong alongside the story, where readers can see them.
      </p>

      <a class="text-link" href="/articles">Meet your next read →</a>
    </div>
  </section>
</Page>