---
import Page from '../layouts/Page.astro';
import PasswordField from '../components/PasswordField';
---
<Page title="Create account" privatePage>
  <section class="auth-network-shell">
    <div class="auth-network-brand">
      <img src="/assets/phonefuturist-mark.svg" alt="" width="150" height="68" />
      <p class="eyebrow">Join PhoneFuturist</p>
      <h1>One account.<br/>The whole network.</h1>
      <p>Read, build, publish simulations and keep your PhoneFuturist identity across the newsroom and Lab.</p>
      <div class="auth-network-points"><span>Follow the news</span><span>Build simulations</span><span>Publish work</span></div>
    </div>

    <div class="auth-card">
      <div><span class="eyebrow">Create account</span><h2>Start here</h2></div>
      {Astro.url.searchParams.has('error') && <p class="notice error" role="alert">We could not complete this request. Use a valid email and a password of 12–128 characters, or try again later.</p>}
      <form class="stack" action="/auth/signup" method="post">
        <label>Email<input name="email" type="email" autocomplete="email" required maxlength="254"/></label>
        <PasswordField autocomplete="new-password" client:load/>
        <button>Create account</button>
      </form>
      <a class="auth-google" href="/auth/google">Continue with Google</a>
      <div class="auth-card-links"><span>Already registered?</span><a href="/login">Sign in</a></div>
    </div>
  </section>
</Page>

<style>
.auth-network-shell{width:min(100%,1100px);margin:0 auto;padding:54px 20px 90px;display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,430px);gap:70px;align-items:center}
.auth-network-brand img{width:128px;height:auto;margin-bottom:18px}
.auth-network-brand h1{margin:6px 0 16px;font-size:clamp(3.2rem,6.6vw,6.4rem);line-height:.9;letter-spacing:-.07em;font-weight:620}
.auth-network-brand>p:not(.eyebrow){max-width:560px;color:var(--muted);font-size:1rem;line-height:1.65}
.auth-network-points{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.auth-network-points span{padding:7px 10px;border:1px solid #22303e;border-radius:999px;color:#8695a6;font-size:.64rem}
.auth-card{padding:26px;border:1px solid #202c39;border-radius:18px;background:linear-gradient(180deg,rgb(22 140 255/.05),transparent 140px),#0b121a;box-shadow:0 26px 70px rgb(0 0 0/.22)}
.auth-card h2{margin:5px 0 22px;font-size:1.6rem;letter-spacing:-.035em}
.auth-card .stack{gap:14px}
.auth-card label{color:#a7b4c1;font-size:.72rem}
.auth-card input{margin-top:6px;min-height:46px;background:#080d13;border-color:#293746}
.auth-card button{width:100%;min-height:46px;margin-top:4px}
.auth-google{display:flex;justify-content:center;align-items:center;min-height:44px;margin-top:10px;border:1px solid #293746;border-radius:9px;color:#c7d2dd;text-decoration:none;font-size:.74rem}
.auth-card-links{display:flex;justify-content:space-between;gap:12px;margin-top:18px;padding-top:16px;border-top:1px solid #202c39;color:#758496;font-size:.68rem}
.auth-card-links a{color:#62cfff;text-decoration:none}
@media(max-width:800px){.auth-network-shell{grid-template-columns:1fr;gap:32px;padding-top:28px}.auth-network-brand h1{font-size:clamp(3.1rem,15vw,4.8rem)}}
</style>


<style>
@media(max-width:800px){
  .auth-network-shell{width:100%;padding:14px 14px 92px;gap:14px}
  .auth-network-brand{padding:22px 18px 18px;border:1px solid #202b37;border-radius:26px;background:linear-gradient(155deg,rgb(22 140 255/.08),transparent 58%),#0b1118}
  .auth-network-brand img{width:74px;margin-bottom:14px}
  .auth-network-brand h1{margin:6px 0 10px;font-size:3rem;line-height:.9}
  .auth-network-brand>p:not(.eyebrow){font-size:.78rem;line-height:1.55}
  .auth-network-points{margin-top:16px;gap:6px}
  .auth-network-points span{padding:7px 10px;background:#0d141c}
  .auth-card{padding:20px;border-radius:24px;box-shadow:none}
  .auth-card h2{font-size:1.45rem}
  .auth-card input{border-radius:14px}
  .auth-card button,.auth-google{border-radius:999px}
}
</style>
