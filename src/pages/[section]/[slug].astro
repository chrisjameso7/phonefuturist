---
import Page from '../../layouts/Page.astro';
import {publishedArticles} from '../../lib/publication';
import {safeHttps} from '../../lib/editorial';
const {articles,unavailable}=await publishedArticles(Astro.url.pathname);
const article=articles[0];
if(unavailable)Astro.response.status=503;else if(!article)Astro.response.status=404;
---
<Page title={article?.title??'Article unavailable'} description={article?.summary}><div class="reading-page">{article?<article><a class="eyebrow" href={'/articles?section='+article.section}>{article.section}</a><h1>{article.title}</h1><p class="intro">{article.summary}</p><p class="byline">By {article.byline} · <time datetime={article.published_at}>{new Date(article.published_at).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></p>{article.withdrawn?<aside class="notice"><h2>Article withdrawn</h2><p>{article.withdrawal_note}</p></aside>:<><div class="article-body">{article.blocks.map(b=>b.type==='heading'?<h2>{b.text}</h2>:b.type==='quote'?<blockquote>{b.text}</blockquote>:b.type==='list'?<ul>{b.text.split('\n').filter(Boolean).map(t=><li>{t}</li>)}</ul>:b.type==='link'&&safeHttps(b.url)?<p><a href={b.url} rel="noopener noreferrer">{b.text}</a></p>:<p>{b.text}</p>)}</div>{article.correction_note&&<aside class="notice"><h2>Editorial note</h2><p>{article.correction_note}</p></aside>}<section class="article-sources"><h2>Sources & evidence</h2><ol>{article.sources.map(s=><li>{safeHttps(s.url)?<a href={s.url} rel="noopener noreferrer">{s.label} ↗</a>:s.label}{s.note&&<p>{s.note}</p>}</li>)}</ol></section></>}</article>:<><h1>{unavailable?'Temporarily unavailable':'Article not found'}</h1><p>{unavailable?'Please retry shortly.':'This story is not available at this address.'}</p></>}<a class="text-link" href="/articles">← Back to the newsroom</a></div></Page>
