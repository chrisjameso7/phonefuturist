---
import Page from '../../layouts/Page.astro';
import InlineContent from '../../components/InlineContent.astro';
import { safeHttps } from '../../lib/editorial';
import { publishedArticles } from '../../lib/publication';
const {section,slug}=Astro.params;
const {articles,unavailable}=await publishedArticles(section && slug ? `/${section}/${slug}` : null);
const article=articles[0] ?? null;
if(!article) Astro.response.status=unavailable?503:404;
const heroImage = article && !article.withdrawn
  ? article.card_image && safeHttps(article.card_image.url)
    ? article.card_image
    : article.blocks.find(block=>block.type==='image' && safeHttps(block.url))
  : null;
---
<Page title={article?.title ?? 'Article unavailable'} description={article?.summary}>
  <div class="reading-page">
    {article ? <article class="story">
      <header class="story-header">
        <a class="story-section" href={`/articles?section=${article.section}`}>{article.section}</a>
        <h1>{article.title}</h1>
        <p class="story-deck">{article.summary}</p>
        <div class="story-meta">
          <span>By {article.byline}</span>
          <time datetime={article.published_at}>{new Date(article.published_at).toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time>
        </div>
      </header>

      {heroImage && <figure class="story-hero">
        <img src={heroImage.url} alt={heroImage.alt ?? ''} loading="eager" decoding="async" referrerpolicy="no-referrer"/>
      </figure>}

      {article.withdrawn ? <aside class="notice"><h2>Article withdrawn</h2><p>{article.withdrawal_note}</p></aside> : <>
        <div class="article-body">
          {article.blocks.map((block,index)=>{
            if(heroImage && block.type==='image' && block.url===heroImage.url && index===article.blocks.findIndex(item=>item.type==='image'&&item.url===heroImage.url)) return null;
            const parts=block.inline ?? [{text:block.text}];
            if(block.type==='heading') return block.level===3?<h3><InlineContent parts={parts}/></h3>:<h2><InlineContent parts={parts}/></h2>;
            if(block.type==='quote') return <blockquote><InlineContent parts={parts}/></blockquote>;
            if(block.type==='list') {
              const items=block.items ?? block.text.split('\n').filter(Boolean).map(text=>[{text}]);
              return block.ordered?<ol>{items.map(item=><li><InlineContent parts={item}/></li>)}</ol>:<ul>{items.map(item=><li><InlineContent parts={item}/></li>)}</ul>;
            }
            if(block.type==='link' && safeHttps(block.url)) return <p><a href={block.url} rel="noopener noreferrer">{block.text}</a></p>;
            if(block.type==='image' && safeHttps(block.url)) return <figure class="article-image">
              <img src={block.url} alt={block.alt ?? ''} loading="lazy" decoding="async" referrerpolicy="no-referrer"/>
              {(block.caption || block.credit || block.sourceName || block.sourceUrl || block.rightsNote || block.ownership==='phonefuturist') && <figcaption>
                {block.caption && <span>{block.caption}</span>}
                {block.credit && <span class="article-image-credit">Credit: {block.credit}</span>}
                {(block.sourceName || safeHttps(block.sourceUrl)) && <span class="article-image-credit">Source: {safeHttps(block.sourceUrl)?<a href={block.sourceUrl} rel="noopener noreferrer">{block.sourceName || 'Original source'}</a>:block.sourceName}</span>}
                {block.rightsNote && <span class="article-image-credit">{block.rightsNote}</span>}
                {block.ownership==='phonefuturist' && <span class="article-image-credit">PhoneFuturist-owned image</span>}
              </figcaption>}
            </figure>;
            return <p><InlineContent parts={parts}/></p>;
          })}
        </div>

        {(article.public_notes?.length ? article.public_notes : article.correction_note ? [{message:article.correction_note,recorded_at:article.updated_at}] : []).map(note=><aside class="notice story-note"><h2>Editorial note</h2><p>{note.message}</p><time datetime={note.recorded_at}>{new Date(note.recorded_at).toLocaleDateString('en-GB',{timeZone:'UTC'})}</time></aside>)}

        {article.sources.length>0 && <section class="article-sources">
          <p class="eyebrow">Reporting record</p>
          <h2>Sources &amp; evidence</h2>
          <ol>{article.sources.map(source=><li>{safeHttps(source.url)?<a href={source.url} rel="noopener noreferrer">{source.label} ↗</a>:source.label}{source.note && <p>{source.note}</p>}</li>)}</ol>
        </section>}
      </>}
    </article> : <section class="story-empty"><h1>{unavailable?'Temporarily unavailable':'Article not found'}</h1><p>{unavailable?'Please retry shortly.':'This story is not available at this address.'}</p></section>}
    <a class="story-back" href="/articles">← Back to the newsroom</a>
  </div>
</Page>

<style>
  .reading-page{width:min(100%,1380px);margin:0 auto;padding:34px clamp(18px,4vw,62px) 80px}
  .story{display:grid}
  .story-header{width:min(100%,980px);margin:34px auto 42px;text-align:left}
  .story-section{display:inline-flex;margin-bottom:18px;color:var(--cyan);font-size:.64rem;font-weight:760;letter-spacing:.13em;text-transform:uppercase;text-decoration:none}
  .story-header h1{max-width:960px;margin:0;font-size:clamp(3.1rem,7.2vw,7.2rem);line-height:.91;letter-spacing:-.07em;font-weight:620}
  .story-deck{max-width:760px;margin:26px 0 20px;color:#a2afbd;font-size:clamp(1.05rem,1.7vw,1.35rem);line-height:1.6}
  .story-meta{display:flex;flex-wrap:wrap;gap:8px 18px;padding-top:16px;border-top:1px solid #202c39;color:#778698;font-size:.72rem}
  .story-hero{width:min(100%,1240px);margin:0 auto 58px}
  .story-hero img{display:block;width:100%;max-height:720px;object-fit:cover;border:1px solid #202c39;border-radius:18px;background:#0b1118}
  .article-body{width:min(100%,760px);margin:0 auto;color:#dfe7ef;font-size:1.08rem;line-height:1.86}
  .article-body>p{margin:0 0 1.55rem}
  .article-body h2{margin:3.8rem 0 1.2rem;font-size:clamp(1.9rem,3.2vw,3rem);line-height:1.08;letter-spacing:-.045em}
  .article-body h3{margin:3rem 0 1rem;font-size:1.45rem}
  .article-body blockquote{margin:3rem 0;padding:4px 0 4px 24px;border-left:3px solid #168cff;color:#b9c5d0;font-size:1.35rem;line-height:1.55}
  .article-body a{color:#62cfff}
  .article-body :is(ul,ol){padding-left:1.35rem;margin:0 0 1.7rem}
  .article-body li{margin:.5rem 0}
  .article-image{width:min(1100px,calc(100vw - 40px));margin:3rem 50%;transform:translateX(-50%)}
  .article-image img{display:block;width:100%;height:auto;border-radius:14px;border:1px solid #202c39}
  .article-image figcaption{margin-top:10px;color:#758496;font-size:.67rem;line-height:1.5}
  .article-image-credit{display:block;margin-top:.25rem}
  .story-note,.article-sources{width:min(100%,760px);margin:44px auto 0}
  .story-note{background:#0d151f;border-left-color:#168cff}
  .article-sources{padding-top:30px;border-top:1px solid #202c39}
  .article-sources h2{margin:5px 0 18px;font-size:1.55rem}
  .article-sources ol{padding-left:1.2rem}
  .article-sources li{margin:0 0 16px;color:#a9b6c3}
  .article-sources li p{margin:4px 0 0;color:#738294;font-size:.78rem}
  .story-back{display:block;width:min(100%,760px);margin:50px auto 0;color:#8e9baa;font-size:.72rem;text-decoration:none}
  .story-empty{min-height:55vh;display:grid;place-content:center;max-width:720px}
  @media(max-width:700px){.reading-page{padding-top:16px}.story-header{margin-top:20px}.story-header h1{font-size:clamp(2.8rem,15vw,4.8rem)}.story-hero{margin-bottom:36px}.article-body{font-size:1rem;line-height:1.78}.article-image{width:100%;margin:2.2rem 0;transform:none}.story-meta{display:grid}}
</style>


<style>
@media(max-width:700px){
  .reading-page{width:100%;padding:12px 0 92px}
  .story-header{width:auto;margin:0 12px 14px;padding:20px 18px 18px;border:1px solid #202b37;border-radius:26px;background:#0b1118}
  .story-section{margin-bottom:12px;font-size:.58rem}
  .story-header h1{font-size:clamp(2.45rem,12vw,3.8rem);line-height:.92;letter-spacing:-.065em}
  .story-deck{margin:18px 0 14px;font-size:.9rem;line-height:1.55}
  .story-meta{display:flex;gap:8px 14px;padding-top:13px;font-size:.62rem}
  .story-hero{width:auto;margin:0 12px 24px}
  .story-hero img{max-height:none;border-radius:26px}
  .article-body{width:auto;margin:0 18px;font-size:.98rem;line-height:1.78}
  .article-body h2{margin:2.8rem 0 1rem;font-size:1.8rem}
  .article-body h3{margin:2.3rem 0 .9rem;font-size:1.3rem}
  .article-body blockquote{margin:2.2rem 0;padding-left:18px;font-size:1.15rem}
  .article-image{width:calc(100% + 12px);margin:2rem -6px;transform:none}
  .article-image img{border-radius:22px}
  .story-note,.article-sources{width:auto;margin:28px 12px 0;padding:18px;border:1px solid #202b37;border-radius:22px;background:#0b1118}
  .story-back{width:auto;margin:28px 18px 0}
}
</style>
