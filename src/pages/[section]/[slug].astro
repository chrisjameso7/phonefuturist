---
import Page from '../../layouts/Page.astro';
import { publishedArticles } from '../../lib/publication';

const { section, slug } = Astro.params;

const path =
  section && slug
    ? `/${section}/${slug}`
    : null;

const { articles, unavailable } =
  await publishedArticles(path);

const article = articles[0] ?? null;

function safeHttps(url?: string | null) {
  if (!url) return false;

  try {
    const parsed = new URL(url);
    return parsed.protocol === 'https:';
  } catch {
    return false;
  }
}
---

<Page
  title={article?.title ?? 'Article unavailable'}
  description={article?.summary}
>
  <div class="reading-page">
    {
      article ? (
        <article>
          <a
            class="eyebrow"
            href={`/articles?section=${article.section}`}
          >
            {article.section}
          </a>

          <h1>{article.title}</h1>

          <p class="intro">
            {article.summary}
          </p>

          <p class="byline">
            By {article.byline} ·{' '}
            <time datetime={article.published_at}>
              {new Date(
                article.published_at,
              ).toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </p>

          {article.withdrawn ? (
            <aside class="notice">
              <h2>Article withdrawn</h2>
              <p>{article.withdrawal_note}</p>
            </aside>
          ) : (
            <>
              <div class="article-body">
                {article.blocks.map((block) => {
                  if (block.type === 'heading') {
                    return <h2>{block.text}</h2>;
                  }

                  if (block.type === 'quote') {
                    return (
                      <blockquote>
                        {block.text}
                      </blockquote>
                    );
                  }

                  if (block.type === 'list') {
                    return (
                      <ul>
                        {block.text
                          .split('\n')
                          .filter(Boolean)
                          .map((item) => (
                            <li>{item}</li>
                          ))}
                      </ul>
                    );
                  }

                  if (
                    block.type === 'link' &&
                    safeHttps(block.url)
                  ) {
                    return (
                      <p>
                        <a
                          href={block.url}
                          rel="noopener noreferrer"
                        >
                          {block.text}
                        </a>
                      </p>
                    );
                  }

                  if (
                    block.type === 'image' &&
                    safeHttps(block.url)
                  ) {
                    return (
                      <figure class="article-image">
                        <img
                          src={block.url}
                          alt={block.alt ?? ''}
                          loading="lazy"
                          decoding="async"
                        />

                        {block.caption && (
                          <figcaption>
                            <span>
                              {block.caption}
                            </span>

                            {block.credit && (
                              <span class="article-image-credit">
                                {' '}
                                ·{' '}
                                {safeHttps(
                                  block.sourceUrl,
                                ) ? (
                                  <a
                                    href={
                                      block.sourceUrl
                                    }
                                    rel="noopener noreferrer"
                                  >
                                    {block.credit}
                                  </a>
                                ) : (
                                  block.credit
                                )}
                              </span>
                            )}
                          </figcaption>
                        )}
                      </figure>
                    );
                  }

                  return <p>{block.text}</p>;
                })}
              </div>

              {article.correction_note && (
                <aside class="notice">
                  <h2>Editorial note</h2>
                  <p>
                    {article.correction_note}
                  </p>
                </aside>
              )}

              <section class="article-sources">
                <h2>Sources & evidence</h2>

                <ol>
                  {article.sources.map(
                    (source) => (
                      <li>
                        {safeHttps(
                          source.url,
                        ) ? (
                          <a
                            href={source.url}
                            rel="noopener noreferrer"
                          >
                            {source.label} ↗
                          </a>
                        ) : (
                          source.label
                        )}

                        {source.note && (
                          <p>
                            {source.note}
                          </p>
                        )}
                      </li>
                    ),
                  )}
                </ol>
              </section>
            </>
          )}
        </article>
      ) : (
        <>
          <h1>
            {unavailable
              ? 'Temporarily unavailable'
              : 'Article not found'}
          </h1>

          <p>
            {unavailable
              ? 'Please retry shortly.'
              : 'This story is not available at this address.'}
          </p>
        </>
      )
    }

    <a
      class="text-link"
      href="/articles"
    >
      ← Back to the newsroom
    </a>
  </div>
</Page>