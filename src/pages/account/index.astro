---
import Page from '../../layouts/Page.astro';
import '../../styles/lab-simulator.css';
const user=Astro.locals.user!;
const access=Astro.locals.access!;
const staff=access.roles.some(r=>['admin','writer','editor','publisher'].includes(r));
let creatorProfile:any=null;
if(Astro.locals.supabase){
  const {data}=await Astro.locals.supabase.from('creator_profiles').select('handle,display_name,bio,avatar_url').eq('user_id',user.id).maybeSingle();
  creatorProfile=data;
}
---
<Page title="Your account" privatePage><div class="account-shell"><aside class="account-sidebar"><nav aria-label="Account"><a href="/account" aria-current="page">⌂ Home</a><a href="/articles">The newsroom</a>{staff&&<a href="/studio">The Studio</a>}<a href="/account/security">Account security</a><a href="/account/password">Change password</a></nav></aside><div class="account-content"><p class="eyebrow">Your PhoneFuturist</p><h1>Welcome back.</h1><p class="account-email">{user.email}</p><div class="account-cards"><section class="account-feature"><p class="eyebrow">Technology, examined</p><h2>A closer look at what comes next.</h2><a class="button button-white" href="/articles">Explore the newsroom →</a></section><section class="panel"><h2>Your account</h2><p class="muted">Email: {access.verified?'Verified':'Verification required'}</p>{staff&&<p>Staff access: {access.roles.filter(r=>r!=='reader').join(', ')}</p>}<p><a href="/account/security">Manage authenticator →</a></p>{staff&&<p><a href="/studio">Open Studio →</a></p>}<form action="/auth/signout" method="post"><button class="secondary">Sign out</button></form></section>
<section class="panel account-creator-panel"><p class="eyebrow">Interactive Leaks creator</p><h2>Public creator identity</h2><p class="muted">This is the identity shown on your public simulations and reusable profiles.</p><form class="account-creator-form" action="/account/api/creator-profile" method="post"><label><span>Display name</span><input name="display_name" maxlength="60" required value={creatorProfile?.display_name??''} placeholder="Your public name" /></label><label><span>Handle</span><input name="handle" maxlength="24" minlength="3" pattern="[a-z0-9_]{3,24}" required value={creatorProfile?.handle??''} placeholder="your_handle" /></label><label><span>Avatar URL</span><input name="avatar_url" type="url" value={creatorProfile?.avatar_url??''} placeholder="https://..." /></label><label><span>Bio</span><textarea name="bio" maxlength="240" rows="3" placeholder="What do you like predicting?">{creatorProfile?.bio??''}</textarea></label><button class="button button-white" type="submit">{creatorProfile?'Update creator profile':'Create creator profile'}</button>{creatorProfile&&<p><a href={`/creator/${creatorProfile.handle}`}>View public profile →</a></p>}</form></section></div></div></div></Page>
