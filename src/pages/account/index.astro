---
import Page from '../../layouts/Page.astro';
const user=Astro.locals.user!;
const access=Astro.locals.access!;
const staff=access.roles.some(r=>['admin','writer','editor','publisher'].includes(r));
---
<Page title="Your account" privatePage><div class="account-shell"><aside class="account-sidebar"><nav aria-label="Account"><a href="/account" aria-current="page">⌂ Home</a><a href="/articles">The newsroom</a>{staff&&<a href="/studio">The Studio</a>}<a href="/account/security">Account security</a><a href="/account/password">Change password</a></nav></aside><div class="account-content"><p class="eyebrow">Your PhoneFuturist</p><h1>Welcome back.</h1><p class="account-email">{user.email}</p><div class="account-cards"><section class="account-feature"><p class="eyebrow">Technology, examined</p><h2>A closer look at what comes next.</h2><a class="button button-white" href="/articles">Explore the newsroom →</a></section><section class="panel"><h2>Your account</h2><p class="muted">Email: {access.verified?'Verified':'Verification required'}</p>{staff&&<p>Staff access: {access.roles.filter(r=>r!=='reader').join(', ')}</p>}<p><a href="/account/security">Manage authenticator →</a></p>{staff&&<p><a href="/studio">Open Studio →</a></p>}<form action="/auth/signout" method="post"><button class="secondary">Sign out</button></form></section></div></div></div></Page>
