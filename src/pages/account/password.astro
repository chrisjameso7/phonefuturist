---
import Page from '../../layouts/Page.astro';
import PasswordField from '../../components/PasswordField';
import { boundedForm, validPassword } from '../../lib/security';
let message = ''; let success = false;
if (Astro.request.method === 'POST') {
  try {
    const form = await boundedForm(Astro.request); const password = form.get('password') ?? '';
    if (!validPassword(password)) message = 'Use a password with 12–128 characters.';
    else {
      const { error } = await Astro.locals.supabase!.auth.updateUser({ password });
      success = !error; message = error ? 'Password could not be changed. You may need a new recovery link or a recent sign-in.' : 'Password updated.';
    }
  } catch { message = 'Unable to process this request.'; }
}
---
<Page title="Change password" privatePage><h1>Change password.</h1>{message && <p class:list={['notice', {error: !success}]} role="status">{message}</p>}<form class="panel stack" method="post"><PasswordField autocomplete="new-password" client:load/><button>Update password</button></form><a href="/account">Back to account</a></Page>
