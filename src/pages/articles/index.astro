---
import Page from '../../layouts/Page.astro';
import ArticleCards from '../../components/ArticleCards.astro';
import {publishedArticles} from '../../lib/publication';
import {sections} from '../../lib/editorial';
const section=Astro.url.searchParams.get('section');
const offset=Math.max(0,Math.min(100000,Math.floor(Number(Astro.url.searchParams.get('offset'))||0)));
const validSection=section&&sections.some(s=>s===section)?section:null;
const {articles,unavailable}=await publishedArticles(null,offset,validSection);
const filtered=validSection?articles.filter(a=>a.section===validSection):articles;
if(unavailable)Astro.response.status=503;
const pageLink=(n:number)=>'/articles?'+new URLSearchParams({offset:String(n),...(section?{section}:{})});
---
<Page title={validSection?validSection.charAt(0).toUpperCase()+validSection.slice(1):'The latest'}>
  <section class="publication-index newsroom-index">
    <header class="newsroom-head">
      <p class="eyebrow">PhoneFuturist Newsroom</p>
      <h1>{validSection?validSection.charAt(0).toUpperCase()+validSection.slice(1):'The latest'}</h1>
      <p>Reporting, analysis and the signals shaping what comes next.</p>
    </header>

    <nav class="section-tabs newsroom-tabs" aria-label="Sections">
      <a href="/articles" aria-current={!section?'page':undefined}>All stories</a>
      {sections.map(s=><a href={'/articles?section='+s} aria-current={section===s?'page':undefined}>{s}</a>)}
    </nav>

    {filtered.length?<ArticleCards articles={filtered}/>:<div class="newsroom-empty"><h2>{unavailable?'Stories are temporarily unavailable.':'No stories on this page yet.'}</h2><p>{unavailable?'Please try again shortly.':'Published reporting will appear here.'}</p></div>}

    <nav class="pagination newsroom-pagination" aria-label="Article pages">
      {offset>0&&<a href={pageLink(Math.max(0,offset-30))}>← Previous</a>}
      {articles.length===30&&<a href={pageLink(offset+30)}>Next →</a>}
    </nav>
  </section>
</Page>

<style>
  .newsroom-index{width:min(100%,1420px);margin:0 auto;padding:42px clamp(18px,3vw,44px) 80px}
  .newsroom-head{max-width:900px;padding:48px 0 36px}
  .newsroom-head h1{margin:8px 0 14px;font-size:clamp(4rem,8vw,8rem);line-height:.88;letter-spacing:-.075em;font-weight:620}
  .newsroom-head>p:not(.eyebrow){max-width:620px;margin:0;color:var(--muted);font-size:1rem}
  .newsroom-tabs{display:flex;gap:4px;margin-bottom:28px;padding:7px;border:1px solid #202c39;border-radius:12px;background:#0b1118;overflow-x:auto}
  .newsroom-tabs a{flex:0 0 auto;padding:9px 13px;border-radius:8px;color:#8593a3;text-decoration:none;font-size:.7rem;text-transform:capitalize}
  .newsroom-tabs a[aria-current="page"]{color:#fff;background:rgb(22 140 255/.12);box-shadow:inset 0 -1px rgb(44 217 255/.25)}
  .newsroom-empty{min-height:360px;display:grid;place-content:center;padding:30px;border:1px solid #202c39;border-radius:16px;background:#0c131c}
  .newsroom-empty h2{margin:0 0 8px;font-size:2rem}
  .newsroom-empty p{margin:0;color:var(--muted)}
  .newsroom-pagination{display:flex;justify-content:space-between;padding-top:30px;font-size:.72rem}
  @media(max-width:650px){.newsroom-index{padding-top:10px}.newsroom-head{padding-top:34px}.newsroom-head h1{font-size:clamp(3.4rem,18vw,5.8rem)}}
</style>
