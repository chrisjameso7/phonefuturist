---
import RoleBadge from '../../components/RoleBadge.astro';
import {publicCreatorRoles,type CreatorRole} from '../../lib/creator-identity';
import Page from '../../layouts/Page.astro';
import { serverClient, settings } from '../../lib/supabase';
import '../../styles/lab-simulator.css';

const handle = (Astro.params.handle ?? '').toLowerCase();
const client = Astro.locals.supabase ?? (settings() ? serverClient(Astro.cookies, Astro.request) : null);

let badges:Array<{badge_name:string}>=[];
let creator:any=null;
let role:CreatorRole|null=null;
let simulations:any[]=[];
let profiles:any[]=[];
let simulationForks=0;
let profileForks=0;

if(client && /^[a-z0-9_]{3,24}$/.test(handle)){
  const {data}=await client.from('creator_profiles').select('user_id,handle,display_name,bio,avatar_url,created_at').eq('handle',handle).maybeSingle();
  creator=data;
  if(creator){
    role=(await publicCreatorRoles(client,[creator.user_id])).get(creator.user_id)??null;
    const {data:badgeRows}=await client.from('user_badges').select('badge_name').eq('user_id',creator.user_id);badges=badgeRows??[];
    const [{data:simRows},{data:profileRows}]=await Promise.all([
      client.from('simulations').select('id,name,device_key,processor_key,configuration_source,updated_at').eq('owner_id',creator.user_id).eq('visibility','public').order('updated_at',{ascending:false}).limit(24),
      client.from('simulation_profiles').select('id,name,component_key,profile_kind,updated_at').eq('owner_id',creator.user_id).eq('visibility','public').order('updated_at',{ascending:false}).limit(24),
    ]);
    simulations=simRows??[];
    profiles=profileRows??[];

    const simIds=simulations.map(item=>item.id);
    const profileIds=profiles.map(item=>item.id);
    if(simIds.length){
      const {data:forks}=await client.from('simulations').select('forked_from').in('forked_from',simIds);
      simulationForks=(forks??[]).length;
    }
    if(profileIds.length){
      const {data:forks}=await client.from('simulation_profiles').select('forked_from').in('forked_from',profileIds);
      profileForks=(forks??[]).length;
    }
  }
}
---

<Page
  title={creator ? `${creator.display_name} · PhoneFuturist` : 'Creator not found'}
  description={creator?.bio || 'Public PhoneFuturist creator profile.'}
>
  <div class="creator-network-page">
    {creator ? (
      <>
        <header class="creator-cover">
          <div class="creator-cover-grid"></div>
          <div class="creator-avatar">
            {creator.avatar_url ? <img src={creator.avatar_url} alt="" loading="lazy" /> : <span>{creator.display_name.slice(0,1).toUpperCase()}</span>}
          </div>
        </header>

        <section class="creator-profile-head">
          <div>
            <div class="creator-name-row">
              <h1>{creator.display_name}</h1>
              <RoleBadge role={role}/>{badges.map(badge=><span class="creator-badge">{badge.badge_name}</span>)}
            </div>
            <p class="creator-handle">@{creator.handle}</p>
            {creator.bio && <p class="creator-bio">{creator.bio}</p>}
          </div>
          <a class="button" href="/interactive-leaks/explore">Explore community</a>
        </section>

        <section class="creator-stats">
          <article><strong>{simulations.length}</strong><span>Simulations</span></article>
          <article><strong>{profiles.length}</strong><span>Profiles</span></article>
          <article><strong>{simulationForks}</strong><span>Simulation forks</span></article>
          <article><strong>{profileForks}</strong><span>Profile forks</span></article>
        </section>

        <nav class="creator-tabs" aria-label="Creator content">
          <a class="is-active" href="#simulations">Simulations</a>
          <a href="#profiles">Profiles</a>
        </nav>

        <section id="simulations" class="creator-feed-section">
          <div class="creator-section-head">
            <div><p class="eyebrow">Published work</p><h2>Simulations</h2></div>
            <span>{simulations.length}</span>
          </div>

          {simulations.length ? <div class="creator-feed">
            {simulations.map(item=><a class="creator-post" href={`/interactive-leaks/simulation/${item.id}`}>
              <div class="creator-post-icon"><img src="/assets/phonefuturist-mark.svg" alt="" width="42" height="20" /></div>
              <div class="creator-post-body">
                <span>{item.device_key.replaceAll('-',' ')}</span>
                <h3>{item.name}</h3>
                <p>{item.processor_key?.replaceAll('_',' ')||'Processor unknown'} · {item.configuration_source}</p>
              </div>
              <b>Open →</b>
            </a>)}
          </div> : <p class="creator-empty">No public simulations yet.</p>}
        </section>

        <section id="profiles" class="creator-feed-section">
          <div class="creator-section-head">
            <div><p class="eyebrow">Reusable work</p><h2>Profiles</h2></div>
            <span>{profiles.length}</span>
          </div>

          {profiles.length ? <div class="creator-feed">
            {profiles.map(item=><a class="creator-post" href={`/interactive-leaks/profile/${item.id}`}>
              <div class="creator-post-icon creator-post-icon-profile">PF</div>
              <div class="creator-post-body">
                <span>{item.component_key.replaceAll('_',' ')}</span>
                <h3>{item.name}</h3>
                <p>{item.profile_kind}</p>
              </div>
              <b>Open →</b>
            </a>)}
          </div> : <p class="creator-empty">No public profiles yet.</p>}
        </section>
      </>
    ) : (
      <section class="creator-missing">
        <img src="/assets/phonefuturist-mark.svg" alt="" width="100" height="46" />
        <h1>Creator not found.</h1>
        <p>This creator profile does not exist or is not available.</p>
        <a class="button" href="/interactive-leaks/explore">Explore community</a>
      </section>
    )}
  </div>
</Page>

<style>
.creator-network-page{width:min(100%,980px);margin:0 auto;padding:20px 18px 80px}
.creator-cover{height:210px;position:relative;overflow:visible;border:1px solid #202c39;border-radius:20px;background:radial-gradient(circle at 78% 22%,rgb(22 140 255/.2),transparent 34%),linear-gradient(145deg,#111a25,#070b11)}
.creator-cover-grid{position:absolute;inset:0;border-radius:inherit;background-image:linear-gradient(rgb(255 255 255/.025) 1px,transparent 1px),linear-gradient(90deg,rgb(255 255 255/.025) 1px,transparent 1px);background-size:36px 36px;mask-image:linear-gradient(#000,transparent)}
.creator-avatar{position:absolute;left:28px;bottom:-48px;width:104px;height:104px;display:grid;place-items:center;border:3px solid var(--paper);border-radius:50%;overflow:hidden;background:linear-gradient(145deg,#142131,#0a0f16);color:#fff;font-size:2rem;font-weight:760}
.creator-avatar img{width:100%;height:100%;object-fit:cover}
.creator-profile-head{display:flex;justify-content:space-between;align-items:end;gap:24px;padding:64px 6px 22px;border-bottom:1px solid #202c39}
.creator-profile-head>div{min-width:0;max-width:100%}.creator-name-row{display:flex;align-items:center;flex-wrap:wrap;gap:10px;min-width:0}
.creator-name-row h1{margin:0;font-size:clamp(2rem,4vw,3.25rem);line-height:1.1;letter-spacing:-.035em;font-weight:500;overflow-wrap:anywhere}
.creator-badge{padding:4px 7px;border-radius:999px;background:rgb(22 140 255/.12);color:#61c9ff;font-size:.56rem;font-weight:760;text-transform:uppercase;letter-spacing:.08em}
.creator-handle{margin:6px 0 0;color:#6f7e90;font-size:.74rem}
.creator-bio{max-width:620px;margin:14px 0 0;color:#a2afbd;line-height:1.6}
.creator-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-bottom:1px solid #202c39}
.creator-stats article{padding:18px 8px;text-align:center}
.creator-stats strong{display:block;font-size:1.35rem}
.creator-stats span{display:block;margin-top:3px;color:#687789;font-size:.6rem}
.creator-tabs{display:flex;gap:4px;padding:12px 0;border-bottom:1px solid #202c39}
.creator-tabs a{display:inline-flex;align-items:center;min-height:44px;padding:8px 11px;border-radius:8px;color:#7c8a9a;text-decoration:none;font-size:.68rem}
.creator-tabs a.is-active{color:#fff;background:#101821;box-shadow:inset 0 -1px #168cff}
.creator-feed-section{padding-top:28px}
.creator-section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:12px}
.creator-section-head h2{margin:4px 0 0;font-size:1.7rem}
.creator-section-head>span{color:#6d7c8d;font-size:.68rem}
.creator-feed{display:grid}
.creator-post{display:grid;grid-template-columns:52px minmax(0,1fr) auto;gap:14px;align-items:center;padding:16px 2px;border-top:1px solid #1d2834;color:var(--ink);text-decoration:none}
.creator-post:hover{background:linear-gradient(90deg,rgb(22 140 255/.035),transparent)}
.creator-post-icon{width:46px;height:46px;display:grid;place-items:center;border:1px solid #243342;border-radius:12px;background:#0b121a}
.creator-post-icon img{width:34px}
.creator-post-icon-profile{color:#61c9ff;font-size:.72rem;font-weight:800}
.creator-post-body>span{color:#2cd9ff;font-size:.56rem;text-transform:uppercase;letter-spacing:.08em}
.creator-post-body h3{margin:3px 0;font-size:.95rem}
.creator-post-body p{margin:0;color:#728193;font-size:.66rem;text-transform:capitalize}
.creator-post>b{color:#6fbfff;font-size:.64rem}
.creator-empty{padding:22px;border:1px solid #202c39;border-radius:12px;color:#718092;background:#0b121a}
.creator-missing{min-height:62vh;display:grid;place-items:start;align-content:center;max-width:620px}
.creator-missing img{width:90px}
.creator-missing h1{margin:16px 0 8px;font-size:3rem}
.creator-missing p{color:var(--muted)}
@media(max-width:650px){.creator-cover{height:150px}.creator-avatar{left:18px;width:88px;height:88px;bottom:-40px}.creator-profile-head{align-items:flex-start;flex-direction:column;padding-top:54px}.creator-stats{grid-template-columns:repeat(2,1fr)}.creator-post{grid-template-columns:46px minmax(0,1fr)}.creator-post>b{display:none}}
</style>
