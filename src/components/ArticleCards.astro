---
import ConfidenceTag from './ConfidenceTag.astro';
import StoryImage from './StoryImage.astro';
import {storyImage} from '../lib/story-image';
import type { PublishedArticle } from '../lib/editorial';

interface Props {
  articles: PublishedArticle[];
}

const { articles } = Astro.props;

---

<div
  class="article-grid"
  data-count={Math.min(articles.length, 4)}
>
  {
    articles.map((article, index) => {
      const image = storyImage(article);

      return (
        <article
          class:list={[
            'article-card',
            {
              'lead-card': index === 0,
              'has-card-image': Boolean(image),
            },
          ]}
        >
          <StoryImage article={article} eager={index===0} />

          <div class="card-content"><ConfidenceTag article={article}/>
            <span class="card-section">
              {article.section}
            </span>

            <h3>
              <a href={article.canonical_path}>
                {article.title}
              </a>
            </h3>

            <p>
              {article.withdrawn
                ? 'This article has been withdrawn. Read the editorial notice.'
                : article.summary}
            </p>

            <div class="card-meta">
              <span>{article.byline}</span>

              <time datetime={article.published_at}>
                {new Date(
                  article.published_at,
                ).toLocaleDateString('en-GB', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            </div>
          </div>
        </article>
      );
    })
  }
</div>

<style>.article-card :global(.story-picture){margin-bottom:0}.article-card :global(figcaption){padding:8px 0;margin:0}.article-card h3 a{text-decoration:none!important}.article-card h3 a:hover{color:var(--pf-brand)}</style>
