---
import ConfidenceTag from './ConfidenceTag.astro';
import StoryImage from './StoryImage.astro';
import StoryByline from './StoryByline.astro';
import type { PublishedArticle } from '../lib/editorial';
interface Props {articles: PublishedArticle[]}
const { articles } = Astro.props;
const [lead,...stories] = articles.filter(article=>!article.withdrawn);
const next = stories.slice(0,2);
const latest = stories.slice(2,8);
const today = new Date().toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<div class="editorial-concept">
 <header class="edition">
  <div class="edition-line"><time datetime={new Date().toISOString().slice(0,10)}>{today}</time><span>Technology, examined.</span></div>
  <div class="edition-title"><h1>Latest stories</h1><a href="/articles">All stories</a></div>
 </header>
 {lead ? <section class="front-page" aria-label="Latest coverage">
  <article class="lead-story">
   <StoryImage article={lead} eager />
   <div class="story-meta"><span class="kicker">{lead.section}</span><ConfidenceTag article={lead}/></div>
   <h2><a href={lead.canonical_path}>{lead.title}</a></h2>
   {lead.summary && <p class="standfirst">{lead.summary}</p>}
   <StoryByline article={lead}/>
  </article>
  {next.length>0 && <section class="next-stories" aria-label="More latest stories">
   {next.map(story=><article><StoryImage article={story}/><div class="story-meta"><span class="kicker">{story.section}</span><ConfidenceTag article={story}/></div><h3><a href={story.canonical_path}>{story.title}</a></h3><StoryByline article={story}/></article>)}
  </section>}
 </section> : <p>Stories are currently unavailable. <a href="/articles">Open the Newsroom</a></p>}
 {latest.length>0 && <section class="latest-edition"><h2>More stories</h2><div class="latest-grid">{latest.map(story=><article><StoryImage article={story}/><div class="story-meta"><span class="kicker">{story.section}</span><ConfidenceTag article={story}/></div><h3><a href={story.canonical_path}>{story.title}</a></h3>{story.summary && <p>{story.summary}</p>}<StoryByline article={story}/></article>)}</div></section>}
 <slot/>
</div>
<style>
.editorial-concept{--ease:cubic-bezier(.22,1,.36,1);padding:clamp(16px,3vw,36px);overflow-wrap:anywhere;max-width:var(--pf-width-content);margin:auto;box-sizing:border-box}
.edition{padding-top:clamp(8px,3vw,40px)}
.edition-line{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;font:400 12px/1.5 var(--font-data);letter-spacing:.04em;color:var(--pf-muted)}
.edition-title{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px;padding:14px 0 clamp(24px,3vw,40px)}
.edition h1{font-size:clamp(2.6rem,6.4vw,5.4rem)!important;line-height:.98!important;letter-spacing:-.045em!important;margin:0}
.edition-title>a{min-height:44px;display:inline-flex;align-items:center;gap:8px;padding:0 20px;border-radius:999px;background:var(--pf-raised);color:var(--pf-primary);font-weight:500;text-decoration:none;transition:background-color .3s var(--ease),transform .3s var(--ease)}
.edition-title>a::after{content:"→";color:var(--pf-brand);transition:transform .3s var(--ease)}
.edition-title>a:hover{background:color-mix(in srgb,var(--pf-raised),var(--pf-primary) 8%)}
.edition-title>a:hover::after{transform:translateX(3px)}
.front-page{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(0,1fr);gap:clamp(28px,4vw,56px);padding-block:8px 48px}
.front-page article{min-width:0}
.story-meta{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}
.story-meta :global(.confidence-tag){margin:0}
.kicker{font:500 12px/1.4 var(--font-ui);color:var(--pf-brand);text-transform:uppercase;letter-spacing:.07em}
article :global(.story-picture){margin-bottom:18px}
article :global(.story-picture a){display:block;overflow:hidden;border-radius:clamp(14px,1.8vw,22px);background:var(--pf-raised);transform:translateZ(0)}
article :global(.story-picture img){border-radius:0;transition:transform 1.1s var(--ease),filter .6s var(--ease)}
article:hover :global(.story-picture img){transform:scale(1.035)}
.lead-story h2{font-size:clamp(2rem,3.6vw,3.3rem)!important;line-height:1.05!important;letter-spacing:-.035em!important;margin:14px 0 14px;max-width:20ch}
h2 a,h3 a{color:var(--pf-primary);text-decoration:none!important;transition:color .3s var(--ease)}
article:hover h2 a,article:hover h3 a{color:color-mix(in srgb,var(--pf-primary),var(--pf-brand) 35%)}
.standfirst{font:400 1.2rem/1.55 var(--font-body);color:var(--pf-secondary);max-width:56ch;margin:0}
.next-stories{display:grid;align-content:start;gap:36px}
.next-stories h3,.latest-edition h3{font-size:1.25rem!important;line-height:1.22!important;letter-spacing:-.02em!important;margin:10px 0 0}
.next-stories :global(.story-picture img){aspect-ratio:16/10}
.latest-edition{padding-block:clamp(40px,5vw,72px) 24px;border-top:1px solid var(--pf-border)}
.latest-edition>h2{font-size:clamp(1.8rem,3vw,2.6rem)!important;letter-spacing:-.035em!important;margin:0 0 clamp(24px,3vw,40px)}
.latest-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:48px 28px}
.latest-grid article{min-width:0}
.latest-grid article:not(:has(.story-picture))::before{content:"";display:block;aspect-ratio:16/10;margin-bottom:18px;border-radius:clamp(14px,1.8vw,22px);background:url(/assets/phonefuturist-mark.svg) center/72px auto no-repeat,radial-gradient(120% 90% at 20% 0%,color-mix(in srgb,var(--pf-brand) 16%,transparent),transparent 60%),var(--pf-raised);opacity:.95}
.latest-grid p{color:var(--pf-secondary);font-size:1rem;line-height:1.6;margin:10px 0 0}
@media(max-width:1020px) and (min-width:761px){.front-page{grid-template-columns:minmax(0,1.4fr) minmax(0,1fr)}.latest-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.front-page{grid-template-columns:minmax(0,1fr);gap:8px;padding-bottom:32px}.next-stories{gap:0;border-top:1px solid var(--pf-border);margin-top:24px}.next-stories article{display:grid;grid-template-columns:minmax(0,1fr) 112px;grid-template-areas:"meta pic" "title pic" "by pic";column-gap:16px;align-content:start;padding:18px 0;border-bottom:1px solid var(--pf-border)}.next-stories article>:global(.story-picture){grid-area:pic;margin:0}.next-stories article>:global(.story-picture a){border-radius:12px}.next-stories article>:global(.story-picture figcaption){display:none}.next-stories article>.story-meta{grid-area:meta}.next-stories article>h3{grid-area:title;font-size:1.05rem!important;margin:6px 0 0}.next-stories article>:global(.story-byline){grid-area:by;margin-top:8px}.latest-grid{grid-template-columns:minmax(0,1fr);gap:40px}.lead-story h2{font-size:2rem!important}.standfirst{font-size:1.06rem}.edition h1{font-size:2.6rem!important}.edition-line span{display:none}.edition-title>a{padding:0 16px}}
@media(prefers-reduced-motion:reduce){article :global(.story-picture img),h2 a,h3 a,.edition-title>a,.edition-title>a::after{transition:none}article:hover :global(.story-picture img){transform:none}}
</style>
