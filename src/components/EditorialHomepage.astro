---
import ConfidenceTag from './ConfidenceTag.astro';
import StoryImage from './StoryImage.astro';
import StoryByline from './StoryByline.astro';
import type { PublishedArticle } from '../lib/editorial';
interface Props {articles: PublishedArticle[]}
const { articles } = Astro.props;
const [lead,...stories] = articles.filter(article=>!article.withdrawn);
const next = stories.slice(0,2);
const latest = stories.slice(2,8);
---
<div class="editorial-concept">
 <header class="edition"><h1>Latest stories</h1><a href="/articles">All stories</a></header>
 {lead ? <section class="front-page" aria-label="Latest coverage">
  <article class="lead-story">
   <StoryImage article={lead} eager />
   <div class="story-meta"><span class="kicker">{lead.section}</span><ConfidenceTag article={lead}/></div>
   <h2><a href={lead.canonical_path}>{lead.title}</a></h2>
   {lead.summary && <p class="standfirst">{lead.summary}</p>}
   <StoryByline article={lead}/>
  </article>
  {next.length>0 && <section class="next-stories" aria-label="More latest stories">
   {next.map(story=><article><StoryImage article={story}/><div class="story-meta"><span class="kicker">{story.section}</span><ConfidenceTag article={story}/></div><h3><a href={story.canonical_path}>{story.title}</a></h3><StoryByline article={story}/></article>)}
  </section>}
 </section> : <p>Stories are currently unavailable. <a href="/articles">Open the Newsroom</a></p>}
 {latest.length>0 && <section class="latest-edition"><h2>More stories</h2><div class="latest-grid">{latest.map(story=><article><StoryImage article={story}/><div class="story-meta"><span class="kicker">{story.section}</span><ConfidenceTag article={story}/></div><h3><a href={story.canonical_path}>{story.title}</a></h3>{story.summary && <p>{story.summary}</p>}<StoryByline article={story}/></article>)}</div></section>}
 <slot/>
</div>
<style>
.editorial-concept{padding:clamp(16px,3vw,36px);overflow-wrap:anywhere;max-width:var(--pf-width-content);margin:auto;box-sizing:border-box}.edition{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--pf-border);padding-bottom:16px}.edition h1{font-size:1.35rem;margin:0}.edition>a{min-height:44px;display:inline-flex;align-items:center}.front-page{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,1fr);gap:32px;padding-block:24px}.front-page article{min-width:0}.story-meta{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}.story-meta :global(.confidence-tag){margin:0}.kicker{font-size:11px;color:var(--pf-secondary);text-transform:uppercase;letter-spacing:.08em}.lead-story h2{font-size:clamp(1.65rem,2.6vw,2.55rem);line-height:1.16;margin:12px 0}h2 a,h3 a{color:var(--pf-primary);text-decoration:none!important}h2 a:hover,h3 a:hover{color:var(--pf-brand)}.standfirst{font:400 1.05rem/1.6 var(--font-body);color:var(--pf-secondary);max-width:62ch}.next-stories{display:grid;gap:24px}.next-stories article+article{border-top:1px solid var(--pf-border);padding-top:24px}.next-stories h3,.latest-edition h3{font-size:1.18rem;line-height:1.3;margin:10px 0}.next-stories :global(.story-picture img){aspect-ratio:16/10}.latest-edition{padding-block:24px;border-top:1px solid var(--pf-border)}.latest-edition>h2{font-size:1.35rem;margin:0 0 24px}.latest-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.latest-grid article{min-width:0}.latest-grid p{color:var(--pf-secondary);font-size:1rem;line-height:1.6}
@media(max-width:760px){.front-page{grid-template-columns:minmax(0,1fr);gap:24px}.next-stories{grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.next-stories article+article{padding-top:0;border:0}.next-stories h3{font-size:1rem}.next-stories :global(figcaption){font-size:11px}.latest-grid{grid-template-columns:minmax(0,1fr)}.lead-story h2{font-size:1.7rem}.standfirst{font-size:1rem}.edition h1{font-size:1.2rem}}
</style>
