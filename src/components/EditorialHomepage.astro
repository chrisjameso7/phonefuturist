---
import ConfidenceTag from './ConfidenceTag.astro';
import StoryImage from './StoryImage.astro';
import StoryByline from './StoryByline.astro';
import type { PublishedArticle } from '../lib/editorial';
interface Props {articles: PublishedArticle[]}
const { articles } = Astro.props;
const [lead,...stories] = articles.filter(article=>!article.withdrawn);
const next = stories.slice(0,2);
const latest = stories.slice(2,8);
const today = new Date().toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
---
<div class="editorial-concept">
 <header class="edition">
  <div class="edition-line"><time datetime={new Date().toISOString().slice(0,10)}>{today}</time><span>Technology, examined.</span></div>
  <div class="edition-title"><h1>Latest stories</h1><a href="/articles">All stories</a></div>
 </header>
 {lead ? <section class="front-page" aria-label="Latest coverage">
  <article class="lead-story">
   <StoryImage article={lead} eager />
   <div class="story-meta"><span class="kicker">{lead.section}</span><ConfidenceTag article={lead}/></div>
   <h2><a href={lead.canonical_path}>{lead.title}</a></h2>
   {lead.summary && <p class="standfirst">{lead.summary}</p>}
   <StoryByline article={lead}/>
  </article>
  {next.length>0 && <section class="next-stories" aria-label="More latest stories">
   {next.map(story=><article><StoryImage article={story}/><div class="story-meta"><span class="kicker">{story.section}</span><ConfidenceTag article={story}/></div><h3><a href={story.canonical_path}>{story.title}</a></h3><StoryByline article={story}/></article>)}
  </section>}
 </section> : <p>Stories are currently unavailable. <a href="/articles">Open the Newsroom</a></p>}
 {latest.length>0 && <section class="latest-edition"><h2>More stories</h2><div class="latest-grid">{latest.map(story=><article><StoryImage article={story}/><div class="story-meta"><span class="kicker">{story.section}</span><ConfidenceTag article={story}/></div><h3><a href={story.canonical_path}>{story.title}</a></h3>{story.summary && <p>{story.summary}</p>}<StoryByline article={story}/></article>)}</div></section>}
 <slot/>
</div>
<style>
.editorial-concept{padding:clamp(16px,3vw,36px);overflow-wrap:anywhere;max-width:var(--pf-width-content);margin:auto;box-sizing:border-box}
.edition{border-top:3px solid var(--pf-primary);padding-top:10px}
.edition-line{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 16px;padding-bottom:10px;border-bottom:1px solid var(--pf-border);font:400 11px/1.5 var(--font-data);letter-spacing:.06em;text-transform:uppercase;color:var(--pf-muted)}
.edition-title{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px;padding:20px 0 18px;border-bottom:1px solid var(--pf-border)}
.edition h1{font-size:clamp(2rem,4.4vw,3.4rem);line-height:1.02;margin:0}
.edition-title>a{min-height:44px;display:inline-flex;align-items:center;gap:6px;font-weight:500;text-decoration:none}
.edition-title>a::after{content:"→";transition:transform var(--pf-motion-fast) ease-out}
.edition-title>a:hover::after{transform:translateX(3px)}
.front-page{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(0,1fr);gap:40px;padding-block:28px}
.front-page article{min-width:0}
.story-meta{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}
.story-meta :global(.confidence-tag){margin:0}
.kicker{font:500 11px/1.4 var(--font-data);color:var(--pf-brand);text-transform:uppercase;letter-spacing:.08em}
.lead-story h2{font-size:clamp(1.9rem,3.2vw,3rem);line-height:1.08;margin:14px 0 12px;max-width:22ch}
h2 a,h3 a{color:var(--pf-primary);text-decoration:none!important;background:linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;transition:background-size var(--pf-motion-base) ease-out}
h2 a:hover,h3 a:hover{color:var(--pf-primary);background-size:100% 1px}
.standfirst{font:400 1.15rem/1.55 var(--font-body);color:var(--pf-secondary);max-width:58ch;margin:0}
.next-stories{display:grid;align-content:start;gap:24px;padding-left:40px;border-left:1px solid var(--pf-border)}
.next-stories article+article{border-top:1px solid var(--pf-border);padding-top:24px}
.next-stories h3,.latest-edition h3{font-size:1.18rem;line-height:1.28;margin:10px 0}
.next-stories :global(.story-picture img){aspect-ratio:16/10}
.latest-edition{padding-block:28px;border-top:3px solid var(--pf-primary)}
.latest-edition>h2{font-size:1.35rem;margin:10px 0 24px}
.latest-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 28px}
.latest-grid article{min-width:0}
.latest-grid article:not(:has(.story-picture))::before{content:"";display:block;aspect-ratio:16/10;margin-bottom:16px;background:repeating-linear-gradient(135deg,transparent 0 11px,color-mix(in srgb,var(--pf-border) 70%,transparent) 11px 12px),var(--pf-raised);border:1px solid var(--pf-border);box-sizing:border-box}
.latest-grid p{color:var(--pf-secondary);font-size:1rem;line-height:1.6}
@media(max-width:1020px) and (min-width:761px){.front-page{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:28px}.next-stories{padding-left:28px}.latest-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.front-page{grid-template-columns:minmax(0,1fr);gap:24px;padding-block:20px}.next-stories{padding-left:0;border-left:0;gap:0;border-top:1px solid var(--pf-border)}.next-stories article,.next-stories article+article{display:grid;grid-template-columns:minmax(0,1fr) 120px;grid-template-areas:"meta pic" "title pic" "by pic";column-gap:16px;align-content:start;padding:16px 0;border-top:0;border-bottom:1px solid var(--pf-border)}.next-stories article>:global(.story-picture){grid-area:pic;margin:0}.next-stories article>:global(.story-picture figcaption){display:none}.next-stories article>.story-meta{grid-area:meta}.next-stories article>h3{grid-area:title;font-size:1.05rem;margin:8px 0 0}.next-stories article>:global(.story-byline){grid-area:by;margin-top:8px}.next-stories :global(.story-picture img){aspect-ratio:16/10}.latest-grid{grid-template-columns:minmax(0,1fr);gap:32px}.lead-story h2{font-size:1.85rem}.standfirst{font-size:1.05rem}.edition h1{font-size:2.1rem}.edition-line span{display:none}}
@media(prefers-reduced-motion:reduce){h2 a,h3 a,.edition-title>a::after{transition:none}}
</style>
