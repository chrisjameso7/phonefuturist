---
const tools=[['/labs/configurator','3D device studio'],['/labs/bom','BOM calculator'],['/labs/thermal','Thermal simulator'],['/labs/display','Display PWM'],['/labs/vault','Concept vault'],['/labs/haptics','Haptics'],['/interactive-leaks','Interactive Leaks']];
const current=Astro.url.pathname;
const label=tools.find(([href])=>href===current)?.[1]??'Interactive Leaks';
---
<nav class="lab-switcher" aria-label="Labs"><a href="/labs">All labs</a><details><summary>{label}<span aria-hidden="true"> ▾</span></summary><div>{tools.map(([href,name])=><a href={href} aria-current={href===current?'page':undefined}>{name}</a>)}</div></details></nav>
<style>
.lab-switcher{display:flex;align-items:start;gap:12px;margin:0 0 18px;position:relative;z-index:5}.lab-switcher>a,.lab-switcher summary,.lab-switcher details a{display:flex;align-items:center;min-height:44px;padding:10px 14px;color:#dce7f3;text-decoration:none;border-radius:12px;box-sizing:border-box}.lab-switcher>a,.lab-switcher summary{border:1px solid #29394a;background:#0b1521}.lab-switcher summary{cursor:pointer;list-style:none;justify-content:space-between;gap:16px}.lab-switcher summary::-webkit-details-marker{display:none}.lab-switcher details{position:relative;min-width:0;width:240px;max-width:calc(100% - 110px)}.lab-switcher details>div{position:absolute;top:52px;right:0;width:100%;box-sizing:border-box;padding:6px;border:1px solid #29394a;border-radius:16px;background:#0b1521;box-shadow:0 18px 35px #0008}.lab-switcher details a[aria-current=page]{background:#75e4d11a;color:#75e4d1}.lab-switcher a:focus-visible,.lab-switcher summary:focus-visible{outline:2px solid #75e4d1;outline-offset:3px}
</style>
