---
import { newsletterSettings } from '../lib/newsletter-settings';
const enabled = !!newsletterSettings();
const id = 'newsletter-' + crypto.randomUUID();
---
<section class="newsletter-signup" aria-labelledby={id}>
  <h2 id={id}>The PhoneFuturist newsletter</h2>
  <p>Technology stories and analysis, delivered weekly.</p>
  <form action="/newsletter" method="post" data-newsletter-form>
    <div class="newsletter-fields">
      <label><span class="newsletter-field-name">First name <small>(optional)</small></span><input name="first_name" autocomplete="given-name" maxlength="80" disabled={!enabled} /></label>
      <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254" disabled={!enabled} /></label>
    </div>
    <div class="newsletter-trap" aria-hidden="true"><label>Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <input name="consent" type="hidden" value="yes" />
    <p class="newsletter-consent">By subscribing you agree to receive the PhoneFuturist newsletter. You can unsubscribe at any time. <a href="/privacy#newsletter">Privacy</a>.</p>
    <button type="submit" disabled={!enabled}>Subscribe</button>
    <p data-newsletter-status role="status" aria-live="polite" aria-atomic="true">{!enabled && 'Newsletter signup is temporarily unavailable.'}</p>
  </form>
</section>
<script>
  document.addEventListener('submit', async event => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches('[data-newsletter-form]')) return;
    event.preventDefault();
    if (form.dataset.busy === 'true') return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const status = form.querySelector<HTMLElement>('[data-newsletter-status]')!;
    form.dataset.busy = 'true'; form.setAttribute('aria-busy', 'true'); button.disabled = true;
    button.textContent = 'Subscribing…'; status.textContent = 'Adding your subscription…';
    try {
      const response = await fetch('/api/newsletter', { method: 'POST', body: new URLSearchParams(new FormData(form) as unknown as Record<string,string>), signal: AbortSignal.timeout(60000) });
      const result = await response.json();
      status.textContent = result.message || 'Signup could not be completed. Please try again.';
      if (response.ok) form.reset();
    } catch { status.textContent = 'Signup could not be completed. Please try again.'; }
    finally { delete form.dataset.busy; form.removeAttribute('aria-busy'); button.disabled = false; button.textContent = 'Subscribe'; }
  });
</script>
<style>
 .newsletter-signup {position:relative;overflow:hidden;isolation:isolate;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.5fr);grid-template-rows:auto 1fr;column-gap:clamp(24px,5vw,72px);padding:clamp(24px,4.5vw,56px);margin:24px 0 40px;background:radial-gradient(90% 120% at 0% 0%,color-mix(in srgb,var(--pf-brand) 14%,transparent),transparent 60%),var(--pf-surface);border:1px solid var(--pf-border);border-radius:clamp(20px,2.6vw,32px);min-width:0;box-sizing:border-box;}
 h2 {grid-column:1;font-size:clamp(1.6rem,2.8vw,2.4rem)!important;line-height:1.05!important;letter-spacing:-.035em!important;margin:0 0 14px;}
 h2+p {grid-column:1;margin:0;font-family:var(--font-body);font-size:1.08rem;}
 p {color:var(--pf-secondary);line-height:1.6;}
 form {grid-column:2;grid-row:1 / span 2;max-width:760px;display:grid;gap:12px;}
 @media(max-width:760px) {.newsletter-signup{grid-template-columns:minmax(0,1fr);grid-template-rows:none;}h2,h2+p,form{grid-column:1;grid-row:auto;}form{margin-top:20px;}}
 .newsletter-fields {display:grid;grid-template-columns:1fr 1.5fr;gap:16px;}
 label {display:grid;gap:8px;min-width:0;}
 label small {color:var(--pf-secondary);font-size:.85rem;}
 input {width:100%;min-width:0;box-sizing:border-box;min-height:44px;background:var(--pf-surface);color:var(--pf-primary);border:1px solid var(--pf-border);border-radius:14px!important;padding:12px 14px;font:inherit;transition:border-color .2s ease,box-shadow .2s ease;}
 input:focus{border-color:var(--pf-brand);box-shadow:0 0 0 4px color-mix(in srgb,var(--pf-brand) 18%,transparent)!important;}
 .newsletter-consent {font-size:.85rem;margin:0;}
 button {justify-self:start;min-height:46px;min-width:132px;padding:0 24px;border-radius:999px!important;font-weight:500;}
 .newsletter-trap {display:none;}
 [data-newsletter-status] {margin:0;}
 :is(input,button,a):focus-visible {outline:2px solid var(--pf-primary);outline-offset:3px;}
 @media(max-width:600px) {.newsletter-fields{grid-template-columns:1fr;}}
</style>
