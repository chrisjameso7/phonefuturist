---
const topics = [
  {label:'News',href:'/articles?section=news',tone:'cyan',path:'M5 4h14v16H5z M8 8h8 M8 12h8 M8 16h5'},
  {label:'Leaks',href:'/articles?section=leaks',tone:'violet',path:'M12 3 3 8l9 5 9-5-9-5z M3 12l9 5 9-5 M3 16l9 5 9-5'},
  {label:'Analysis',href:'/articles?section=analysis',tone:'coral',path:'M5 19V9 M12 19V4 M19 19v-7'},
  {label:'Reports',href:'/articles?section=reports',tone:'gold',path:'M6 3h9l4 4v14H6z M14 3v5h5 M9 12h7 M9 16h7'},
  {label:'The Lab',href:'/interactive-leaks',tone:'mint',path:'M9 3h6 M10 3v6L4 19q-1 2 2 2h12q3 0 2-2L14 9V3 M7 15h10'},
  {label:'Explore',href:'/community',tone:'blue',path:'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M15 9l-2 4-4 2 2-4 4-2z'},
