---
<nav class="pf-mobile-topics" aria-label="Discover PhoneFuturist">
  <div class="pf-mobile-section-heading"><span>Explore your interests</span><a href="/articles">View all ↗</a></div>
  <div class="pf-mobile-topic-scroll">{topics.map(t=><a href={t.href} class:list={['pf-mobile-topic',t.tone]}><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.path}/></svg></span><strong>{t.label}</strong></a>)}</div>
</nav>
