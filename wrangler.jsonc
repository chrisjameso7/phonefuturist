{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phonefuturist-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "AI_VALUATION_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "AI_VALUATION_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 2,
        "period": 60
      }
    },
    {
      "name": "NEWSLETTER_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
