{
  "version": "system-efficiency-cohort-0.1.0",
  "purpose": "Cross-brand seed cohort for workload-specific system-efficiency calibration. Raw protocol observations only. These are not final software coefficients.",
  "rules": {
    "no_brand_priors": true,
    "do_not_average_across_protocols": true,
    "coefficient_requires_hardware_normalization": true,
    "missing_data_is_unknown_not_neutral_evidence": true
  },
