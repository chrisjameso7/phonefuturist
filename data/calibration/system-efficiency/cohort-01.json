      "url": "https://www.tomsguide.com/"
    },
    {
      "id": "phonearena",
      "role": "cross_check_browsing_video_gaming",
      "url": "https://www.phonearena.com/"
    },
    {
      "id": "dxomark",
      "role": "display_camera_context",
      "url": "https://www.dxomark.com/"
    }
  ],
